# PostMind Studio — Prometheus configuration on Render. Rendered at container start by
# ops/render/monitoring/entrypoint.sh, which replaces the double-underscore placeholders with the internal
# hostnames Render gives each service (render.yaml passes them in with fromService `host`).
# Same job names, bearer-token file and rule files as ops/prometheus/prometheus.yml, so the alert
# rules (ops/prometheus/studio-alerts.yml) and SLO rules (studio-slo.yml) work unchanged:
#   studio-web        GET :3010/api/metrics on every web instance      (Bearer METRICS_TOKEN)
#   studio-worker     GET :9464/metrics on every worker instance        (Bearer METRICS_TOKEN)
#   studio-readiness  blackbox http_2xx probe of the web's /api/health/ready
# "<host>-discovery" resolves to every running instance of a service
# (https://render.com/docs/private-network), so scaling needs no config change.

global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels:
    service: postmind-studio
    environment: __ENVIRONMENT__

rule_files:
  - /etc/prometheus/rules/studio-alerts.yml
  - /etc/prometheus/rules/studio-slo.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']

scrape_configs:
  - job_name: studio-web
    metrics_path: /api/metrics
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/metrics-token
    dns_sd_configs:
      - names: ['__WEB_HOST__-discovery']
        type: A
        port: 3010
        refresh_interval: 30s

  - job_name: studio-worker
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/metrics-token
    dns_sd_configs:
      - names:
          - __ORCHESTRATION_HOST__-discovery
          - __ASSETS_HOST__-discovery
          - __PUBLISH_HOST__-discovery
          - __SCHEDULED_HOST__-discovery
          - __ANALYTICS_HOST__-discovery
          - __LIBRARY_HOST__-discovery
          - __EMAIL_HOST__-discovery
        type: A
        port: 9464
        refresh_interval: 30s

  - job_name: studio-readiness
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['http://__WEB_HOST__:3010/api/health/ready']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']

  - job_name: alertmanager
    static_configs:
      - targets: ['127.0.0.1:9093']
