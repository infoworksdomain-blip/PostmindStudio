# -----------------------------------------------------------------------------
# AI providers — text and script generation
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=""
# Layers 1-2 model (spec 5.2: "Claude Sonnet"). Must have a row in
# src/lib/studio/providers/anthropic.ts MODEL_PRICING_USD_PER_MTOK.
ANTHROPIC_MODEL="claude-sonnet-5"

OPENAI_API_KEY=""

# Image model for IMAGE_STILL shots. DALL-E 3 was removed from the API on 2026-05-12;
# gpt-image-2 is OpenAI's named replacement. Embeddings always use text-embedding-3-large @1536.
OPENAI_IMAGE_MODEL="gpt-image-2"
# 15.C1: Layers 1–2 text fallback when Claude is unavailable (spec 5.2 "GPT-4o as fallback";
# GPT-4o is legacy, gpt-6-sol is the current balanced model). Needs a row in
# src/lib/studio/providers/openai-text.ts TEXT_PRICING. Transcription fallback always uses whisper-1
# (the model with word timestamps).
OPENAI_TEXT_MODEL="gpt-6-sol"

# 15.C3 (spec 11.4): Studio-side provider rate windows, "<max>/<windowSec>[,org=<max>/<windowSec>]"
# per provider id (upper-case, non-alphanumerics as _). A full window delays the job (BullMQ
# moveToDelayed) instead of failing it. Unset = no Studio-side limit. Needs REDIS_URL. Example:
# STUDIO_PROVIDER_RATE_PEXELS_VIDEO="200/3600,org=50/3600"   (Pexels default: 200 requests/hour)


# -----------------------------------------------------------------------------
# AI providers — video generation
# -----------------------------------------------------------------------------

RUNWAY_API_KEY=""

# Luma Agents API key (platform.lumalabs.ai; keys start "luma-api-"). AI_CLIP fallback for
# Runway (ray-3.2 on https://agents.lumalabs.ai/v1). Registered only when set.
LUMA_API_KEY=""

# BACKLOG 20.20 — Google Veo 3.1 through the Gemini API: the AI_CLIP fallback after Seedance and
# before Runway and Luma (20.23). Registered only when set. Get the key in Google AI Studio
# (https://aistudio.google.com/apikey → Create API key) and enable billing on its project
# (AI Studio → "Set up billing"; Veo has no free tier, Prepay needs at least $5 of credit).
# Generated clips are kept by Google for 2 days; Studio copies them to the assets bucket at once.
GOOGLE_GEMINI_API_KEY=""
# Optional. veo-3.1-fast-generate-preview (default, $0.10/s at 720p), veo-3.1-generate-preview
# ($0.40/s) or veo-3.1-lite-generate-preview ($0.05/s). https://ai.google.dev/gemini-api/docs/pricing
VEO_MODEL=""
# Optional; leave empty. Text-to-video then sends no personGeneration (the API refuses allow_adult
# there); image-to-video always sends allow_adult. allow_all only for servers outside EU/UK/CH/MENA.
VEO_PERSON_GENERATION=""

# BACKLOG 20.23 — BytePlus ModelArk Seedance: the first AI_CLIP option on every plan
# (seedance → kling → veo → runway → luma). STANDARD uses SEEDANCE_MODEL; PLUS/ENTERPRISE, and shots longer
# than SEEDANCE_MODEL can render, use SEEDANCE_LONG_MODEL. Registered only when set. console.byteplus.com → ModelArk → API keys (region ap-southeast-1) → Create API Key;
# activate the Seedance models (ModelArk → Model activation) and keep a prepaid balance (the
# 2.0/2.5 models need > $30 balance, a $30+ AI Savings Plan or a Seedance resource pack to
# activate; service is suspended after 2 hours in arrears). Clip URLs last 24 hours; Studio copies
# them to the assets bucket at once. https://docs.byteplus.com/en/docs/modelark/model-pricing
BYTEPLUS_API_KEY=""
# Optional. dreamina-seedance-2-0-mini-260615 (default, 4–15 s, $3.5 per M tokens ≈ $0.076/s at
# 720p), dreamina-seedance-2-0-fast-260128 ($5.6), dreamina-seedance-2-0-260128 ($7.0) or
# dreamina-seedance-2-5-260628 ($10.7, 4–30 s). List prices; promotions are ignored on purpose.
SEEDANCE_MODEL=""
# Optional. Model for PLUS/ENTERPRISE plans and for shots longer than SEEDANCE_MODEL can render
# (default dreamina-seedance-2-5-260628, up to 30 s).
SEEDANCE_LONG_MODEL=""
# Optional. ModelArk data-plane URL; default https://ark.ap-southeast.bytepluses.com/api/v3
# (ap-southeast-1, Johor — the only region with Seedance as of 2026-10-02).
BYTEPLUS_ARK_BASE_URL=""

# Google Cloud project for Vertex AI. Not used: Veo goes through the Gemini API key above.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_APPLICATION_CREDENTIALS=""

# BACKLOG 20.24 — Kling 3.0 (Kling AI Pte. Ltd., Singapore): the SECOND AI_CLIP option (order
# seedance → kling → veo → runway → luma). Registered only when
# set. Get the key at https://kling.ai/dev → Console → API Key → "+ Create a new API Key" (shown
# once), after buying a video resource package (https://kling.ai/dev/pricing: prepaid units,
# $0.14 each, 180-day validity). Sent as "Authorization: Bearer <key>". Clips are requested
# silent (720p: 0.6 units = $0.084 a second). Kling clears results after 30 days; Studio copies
# them to the assets bucket at once.
KLING_API_KEY=""
# Legacy alternative (older accounts): the AccessKey + SecretKey pair, signed into a 30-minute
# HS256 JWT per request. Set BOTH, and only when KLING_API_KEY is empty (the API key wins).
# Kling documents the pair for its "legacy version" APIs; prefer an API key for Kling 3.0.
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""
# Optional. Only kling-3.0 (default) is priced and supported.
KLING_MODEL=""
# Optional. 720p (default, $0.084/s silent) or 1080p ($0.112/s). 4k is not offered.
KLING_RESOLUTION=""
# Optional. Default https://api-singapore.klingai.com (Kling's endpoint for servers outside China).
KLING_BASE_URL=""

PIKA_API_KEY=""

FAL_API_KEY=""

REPLICATE_API_KEY=""


