# =============================================================================
# PostMind Studio — Environment Variables
# =============================================================================
# Copy this file to .env.local and populate with real values.
# .env.local is git-ignored. NEVER commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Core service
# -----------------------------------------------------------------------------

# Postgres connection string. Use the studio schema.
# Format: postgres://user:pw@host:5432/dbname?schema=studio
DATABASE_URL="postgresql://studio:studio@localhost:5432/postmind?schema=studio"

# Redis connection URL for BullMQ. Studio uses DB 3 by convention.
REDIS_URL="redis://localhost:6379/3"

# Runtime mode. Affects logging verbosity and Prisma query logs.
NODE_ENV="development"

# HTTP port. Defaults to 3010 (Studio) to avoid clash with PostMind Core on 3000.
PORT="3010"

# Public base URL of the service.
APP_URL="http://localhost:3010"


# -----------------------------------------------------------------------------
# PostMind Core integration
# -----------------------------------------------------------------------------

# Base URL of the PostMind Core API for tenant/user context lookups.
POSTMIND_CORE_URL="http://localhost:3000"

# JWKS endpoint of PostMind Core's auth service. Used to verify JWTs.
POSTMIND_JWKS_URL="http://localhost:3000/.well-known/jwks.json"

# Expected JWT issuer claim. Reject tokens with any other iss.
POSTMIND_JWT_ISSUER="postmind-core"

# Expected JWT audience claim. Reject tokens with any other aud.
POSTMIND_JWT_AUDIENCE="postmind-studio"

# Long-lived shared secret for service-to-service calls. Rotate quarterly.
# Generate with: openssl rand -hex 32
POSTMIND_SERVICE_TOKEN=""

# Audit ingest endpoint URL.
POSTMIND_AUDIT_URL="http://localhost:3000/api/internal/audit"


# -----------------------------------------------------------------------------
# Object storage (S3-compatible)
# -----------------------------------------------------------------------------

AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Bucket names (create these first, or use different names in dev)
S3_BUCKET_ASSETS="studio-assets-dev"
S3_BUCKET_RENDERS="studio-renders-dev"
S3_BUCKET_THUMBNAILS="studio-thumbnails-dev"
S3_BUCKET_LIBRARY="studio-library-assets-dev"

# CloudFront distribution URL for signed CDN URLs (optional in dev)
CDN_URL=""


# -----------------------------------------------------------------------------
# KMS (envelope encryption for platform tokens, voice profiles, BYOC keys)
# -----------------------------------------------------------------------------

KMS_KEY_ID=""


# -----------------------------------------------------------------------------
# Meta (Instagram + Facebook)
# -----------------------------------------------------------------------------
# NOTE: Studio does NOT store Meta tokens directly. It reads them from the
# Engagement service's platform_connections table via internal API.

META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"

# Internal endpoint on Engagement service to fetch a channel's Meta token.
ENGAGEMENT_INTERNAL_URL="http://localhost:3001"


# -----------------------------------------------------------------------------
# TikTok Content Posting API
# -----------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=tiktok"


# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------

YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=youtube"

# YouTube quota — request an increase before production.
YOUTUBE_DAILY_QUOTA="10000"


# -----------------------------------------------------------------------------
# X (Twitter) API
# -----------------------------------------------------------------------------

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=x"


# -----------------------------------------------------------------------------
# LinkedIn Marketing API
# -----------------------------------------------------------------------------

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=linkedin"


# -----------------------------------------------------------------------------
# AI providers — text and script generation
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

OPENAI_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — video generation
# -----------------------------------------------------------------------------

RUNWAY_API_KEY=""

LUMA_API_KEY=""

# Google Cloud project for Vertex AI (Veo)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_APPLICATION_CREDENTIALS=""

KLING_API_KEY=""

PIKA_API_KEY=""

FAL_API_KEY=""

REPLICATE_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — avatars
# -----------------------------------------------------------------------------

HEYGEN_API_KEY=""

SYNTHESIA_API_KEY=""

DID_API_KEY=""

TAVUS_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — voice
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL="eleven_multilingual_v2"

# Azure Speech (fallback)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="uksouth"


# -----------------------------------------------------------------------------
# AI providers — music
# -----------------------------------------------------------------------------

SUNO_API_KEY=""


# -----------------------------------------------------------------------------
# Stock media
# -----------------------------------------------------------------------------

STORYBLOCKS_API_PUBLIC_KEY=""
STORYBLOCKS_API_PRIVATE_KEY=""

PEXELS_API_KEY=""

UNSPLASH_ACCESS_KEY=""


# -----------------------------------------------------------------------------
# Composition
# -----------------------------------------------------------------------------

SHOTSTACK_API_KEY=""
SHOTSTACK_ENVIRONMENT="stage"

CREATOMATE_API_KEY=""


# -----------------------------------------------------------------------------
# Captions
# -----------------------------------------------------------------------------

ASSEMBLYAI_API_KEY=""


# -----------------------------------------------------------------------------
# Content safety
# -----------------------------------------------------------------------------

HIVE_API_KEY=""

SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""


# -----------------------------------------------------------------------------
# Website scanning (Feature D)
# -----------------------------------------------------------------------------

# If using Browserless.io for JS-rendered page scans (optional).
BROWSERLESS_API_KEY=""


# -----------------------------------------------------------------------------
# Video library indexing (Feature A — optional, only if using Twelve Labs)
# -----------------------------------------------------------------------------

TWELVE_LABS_API_KEY=""


# -----------------------------------------------------------------------------
# Classifier configuration
# -----------------------------------------------------------------------------

# Default classifier: 'heuristic' (deterministic) or 'anthropic' (uses Claude)
STUDIO_CLASSIFIER="anthropic"

# Cost caps (in pence)
CLASSIFIER_DAILY_CAP_PER_ORG="500"
CLASSIFIER_DAILY_CAP_GLOBAL="10000"


# -----------------------------------------------------------------------------
# Queue and workers
# -----------------------------------------------------------------------------

BULLMQ_QUEUE_PREFIX="studio"
WORKER_CONCURRENCY_ORCHESTRATION="10"
WORKER_CONCURRENCY_ASSETS="15"
WORKER_CONCURRENCY_PUBLISH="5"
WORKER_CONCURRENCY_ANALYTICS="5"
WORKER_MAX_JOBS_PER_WORKER="10000"


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

SENTRY_DSN=""

LOG_LEVEL="info"


# -----------------------------------------------------------------------------
# Feature flags (per-environment overrides)
# -----------------------------------------------------------------------------

FEATURE_LIBRARY_ENABLED="true"
FEATURE_OVERLAYS_ENABLED="true"
FEATURE_SLIDESHOW_ENABLED="true"
FEATURE_IMAGE_LIBRARY_ENABLED="true"
