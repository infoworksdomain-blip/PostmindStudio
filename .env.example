# =============================================================================
# PostMind Studio — Environment Variables
# =============================================================================
# Copy this file to .env.local and populate with real values.
# .env.local is git-ignored. NEVER commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Core service
# -----------------------------------------------------------------------------

# Postgres connection string. Use the studio schema.
# Format: postgres://user:pw@host:5432/dbname?schema=studio
DATABASE_URL="postgresql://studio:studio@localhost:5432/postmind?schema=studio"

# Redis connection URL for BullMQ. Studio uses DB 3 by convention.
REDIS_URL="redis://localhost:6379/3"

# Runtime mode. Affects logging verbosity and Prisma query logs.
NODE_ENV="development"

# HTTP port. Defaults to 3010 (Studio) to avoid clash with PostMind Core on 3000.
PORT="3010"

# Public base URL of the service.
APP_URL="http://localhost:3010"


# -----------------------------------------------------------------------------
# PostMind Core integration
# -----------------------------------------------------------------------------

# Base URL of the PostMind Core API for tenant/user context lookups.
POSTMIND_CORE_URL="http://localhost:3000"

# JWKS endpoint of PostMind Core's auth service. Used to verify JWTs.
POSTMIND_JWKS_URL="http://localhost:3000/.well-known/jwks.json"

# Expected JWT issuer claim. Reject tokens with any other iss.
POSTMIND_JWT_ISSUER="postmind-core"

# Expected JWT audience claim. Reject tokens with any other aud.
POSTMIND_JWT_AUDIENCE="postmind-studio"

# Browser UI (BACKLOG 10.2): name of PostMind's session cookie that carries the JWT when the
# studio.postmind.ai pages call the API. Requires Studio to share the cookie domain with Core.
# Unset = only Authorization: Bearer is accepted.
POSTMIND_SESSION_COOKIE=""

# Long-lived shared secret for service-to-service calls. Rotate quarterly.
# Generate with: openssl rand -hex 32
POSTMIND_SERVICE_TOKEN=""

# Audit ingest endpoint URL.
POSTMIND_AUDIT_URL="http://localhost:3000/api/internal/audit"


# -----------------------------------------------------------------------------
# Object storage (S3-compatible)
# -----------------------------------------------------------------------------

AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Bucket names (create these first, or use different names in dev)
S3_BUCKET_ASSETS="studio-assets-dev"
S3_BUCKET_RENDERS="studio-renders-dev"
S3_BUCKET_THUMBNAILS="studio-thumbnails-dev"
S3_BUCKET_LIBRARY="studio-library-assets-dev"
# s3:// corpus sources for POST /admin/library/ingest: comma-separated `bucket` or
# `bucket/prefix/` entries Studio's storage credentials may read. Empty = s3:// refused (https://
# sources are always fetched through the SSRF guard). runbooks/corpus-ingestion.md
STUDIO_CORPUS_S3_BUCKETS=""

# CloudFront distribution URL for signed CDN URLs (optional in dev). When set, the key pair
# below is REQUIRED and objects in CDN_BUCKET are served as CloudFront signed URLs (canned
# policy, same expiry as the S3 presigned URLs); other buckets stay S3 presigned (13.30).
CDN_URL=""
# The S3 bucket behind the distribution (default: S3_BUCKET_RENDERS).
CDN_BUCKET=""
# CloudFront public key id from the distribution's trusted key group.
CLOUDFRONT_KEY_PAIR_ID=""
# Matching RSA private key, PEM (escaped newlines allowed on one line) — or base64 of the PEM below.
CLOUDFRONT_PRIVATE_KEY=""
CLOUDFRONT_PRIVATE_KEY_BASE64=""


# -----------------------------------------------------------------------------
# KMS (envelope encryption for platform tokens, voice profiles, BYOC keys)
# -----------------------------------------------------------------------------

KMS_KEY_ID=""

# Local development only (refused when NODE_ENV=production): when KMS_KEY_ID is empty,
# data keys are wrapped with this 32-byte base64 master key instead of KMS.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_LOCAL_MASTER_KEY=""


# -----------------------------------------------------------------------------
# Meta (Instagram + Facebook)
# -----------------------------------------------------------------------------
# Meta tokens (operator decision 2026-09-27, Engagement handover 9.5 / 9.6 / 14.13 pattern):
# PostMind Core runs the Meta login and pushes page / IG tokens to Studio's internal endpoints
# (POST /api/studio/internal/channels, DELETE /api/studio/internal/channels/:id,
# POST /api/studio/internal/tokens/refreshed). Studio stores them envelope-encrypted (KMS_KEY_ID /
# STUDIO_LOCAL_MASTER_KEY) in studio.platform_connections and never refreshes them itself.

META_APP_ID=""
META_APP_SECRET=""
# Graph API version used by the Reels publishers (Graph API changelog, 2026).
META_GRAPH_API_VERSION="v26.0"

# Engagement internal API (auth: X-Service-Token = POSTMIND_SERVICE_TOKEN).
# Used for publication attribution (spec 16.3).
ENGAGEMENT_INTERNAL_URL="http://localhost:3001"

# INBOUND service token PostMind Core sends as X-Service-Token on /api/studio/internal/**.
# At least 32 characters (openssl rand -hex 32); compared in constant time. Unset or shorter =
# the internal endpoints answer 404 (disabled). Different from POSTMIND_SERVICE_TOKEN (outbound).
# The /api/studio/internal/* paths must be reachable ONLY from the private network: bind them to
# private ingress, never the public load balancer (Engagement handover 14.13).
STUDIO_INTERNAL_SERVICE_TOKEN=""
# Requests per minute Core may make to the internal endpoints (Redis window). Unset = 600.
STUDIO_INTERNAL_RATE_LIMIT_PER_MIN=""


# -----------------------------------------------------------------------------
# TikTok Content Posting API
# -----------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=tiktok"


# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------

YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=youtube"

# YouTube quota — request an increase before production.
YOUTUBE_DAILY_QUOTA="10000"


# -----------------------------------------------------------------------------
# X (Twitter) API
# -----------------------------------------------------------------------------

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=x"


# -----------------------------------------------------------------------------
# LinkedIn Marketing API
# -----------------------------------------------------------------------------

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3010/api/studio/platform-connections/oauth-callback?platform=linkedin"
# Post analytics need LinkedIn's Community Management API (r_member_postAnalytics, vetted access).
# Set to "enabled" only once the app is approved; connections made before need reconnecting.
LINKEDIN_POST_ANALYTICS=""


# -----------------------------------------------------------------------------
# AI providers — text and script generation
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=""
# Layers 1-2 model (spec 5.2: "Claude Sonnet"). Must have a row in
# src/lib/studio/providers/anthropic.ts MODEL_PRICING_USD_PER_MTOK.
ANTHROPIC_MODEL="claude-sonnet-5"

OPENAI_API_KEY=""

# Image model for IMAGE_STILL shots. DALL-E 3 was removed from the API on 2026-05-12;
# gpt-image-2 is OpenAI's named replacement. Embeddings always use text-embedding-3-large @1536.
OPENAI_IMAGE_MODEL="gpt-image-2"


# -----------------------------------------------------------------------------
# AI providers — video generation
# -----------------------------------------------------------------------------

RUNWAY_API_KEY=""

# Luma Agents API key (platform.lumalabs.ai; keys start "luma-api-"). AI_CLIP fallback for
# Runway (ray-3.2 on https://agents.lumalabs.ai/v1). Registered only when set.
LUMA_API_KEY=""

# Google Cloud project for Vertex AI (Veo)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_APPLICATION_CREDENTIALS=""

KLING_API_KEY=""

PIKA_API_KEY=""

FAL_API_KEY=""

REPLICATE_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — avatars
# -----------------------------------------------------------------------------

# HeyGen API key (app.heygen.com/developers; sent as x-api-key to the v3 API). AI_AVATAR shots.
# Registered only when set, and then HEYGEN_AVATAR_ID is required: the stock (or brand) avatar
# look id, from GET https://api.heygen.com/v3/avatars/looks. Setting the key makes Layer 2 offer
# AI_AVATAR shots; the avatar lip-syncs to the ElevenLabs narration.
HEYGEN_API_KEY=""
HEYGEN_AVATAR_ID=""
# Only for npm run gate2:heygen: a public HTTPS MP3/WAV to lip-sync, and its length in seconds.
HEYGEN_TEST_AUDIO_URL=""
HEYGEN_TEST_AUDIO_SEC=""

SYNTHESIA_API_KEY=""

DID_API_KEY=""

TAVUS_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — voice
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL="eleven_multilingual_v2"
# Any voice id from your ElevenLabs voice library. Used by scripts/test-elevenlabs.ts only;
# production voices come from voice_profiles / brand kits.
ELEVENLABS_VOICE_ID=""
# Narration voice when a brand kit has no cloned voice (spec 5.5). Required for voiceover.
ELEVENLABS_DEFAULT_VOICE_ID=""
# 13.13 voice cloning (ElevenLabs Instant Voice Cloning, uses ELEVENLABS_API_KEY): lowest plan
# tier allowed to clone a voice. Spec 13.4: below Enterprise only stock voices. Playbook
# decision A-06 is still open. BASIC | STANDARD | PLUS | ENTERPRISE (default ENTERPRISE).
STUDIO_VOICE_CLONE_MIN_TIER="ENTERPRISE"

# Azure Speech (fallback)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="uksouth"


# -----------------------------------------------------------------------------
# AI providers — music (Layer 5)
# -----------------------------------------------------------------------------
# ElevenLabs Music replaces Suno (no public API). It uses ELEVENLABS_API_KEY above; the account
# must be on a paid plan (Starter+ for commercial use; https://elevenlabs.io/pricing/api,
# $0.15 per generated minute). Registered as provider `elevenlabs-music` whenever the key is set.
# Model: music_v1 | music_v2 | music_v2_5 (https://elevenlabs.io/docs/api-reference/music/compose).
ELEVENLABS_MUSIC_MODEL="music_v2_5"
# Lowest plan tier that gets a generated track: BASIC | STANDARD | PLUS | ENTERPRISE.
# Default STANDARD — spec 12.4 lists no music for Basic, so Basic renders are narration-only.
STUDIO_MUSIC_MIN_TIER="STANDARD"


# -----------------------------------------------------------------------------
# Stock media
# -----------------------------------------------------------------------------

# Also enable Layer 5 sound effects (storyblocks-audio adapter, content_type=sfx; 13.27).
STORYBLOCKS_API_PUBLIC_KEY=""
STORYBLOCKS_API_PRIVATE_KEY=""

PEXELS_API_KEY=""

UNSPLASH_ACCESS_KEY=""


# -----------------------------------------------------------------------------
# Composition
# -----------------------------------------------------------------------------

SHOTSTACK_API_KEY=""
# "stage" = watermarked sandbox, "v1" = production. Keys differ per environment.
SHOTSTACK_ENVIRONMENT="stage"

CREATOMATE_API_KEY=""


# -----------------------------------------------------------------------------
# Captions
# -----------------------------------------------------------------------------

ASSEMBLYAI_API_KEY=""
# "us" (default, api.assemblyai.com) or "eu" (api.eu.assemblyai.com) for EU data residency.
ASSEMBLYAI_REGION="us"


# -----------------------------------------------------------------------------
# Content safety
# -----------------------------------------------------------------------------

HIVE_API_KEY=""
# Public https origin of this Studio deployment that Hive can reach. Renders longer than Hive's
# 90 s sync limit are scanned with Hive's async API, which POSTs results to
# <origin>/api/studio/webhooks/hive?token=<per-task token>. Unset = long renders fail the
# content-safety check (fail closed). Route that path from the public ingress (13.25).
STUDIO_PUBLIC_CALLBACK_BASE_URL=""
# Minutes to wait for Hive's callback before failing the check closed (1–1440, default 120).
HIVE_ASYNC_TIMEOUT_MIN="120"

SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""


# -----------------------------------------------------------------------------
# Website scanning (Feature D)
# -----------------------------------------------------------------------------

# Text overlays (Feature B). Shotstack has no system fonts: every overlay font must be
# hosted as <FamilyWithoutSpaces>.ttf under this URL (e.g. https://cdn.example.com/fonts/
# Montserrat.ttf, BebasNeue.ttf). Built-in presets use: Montserrat, Inter, Poppins, Anton,
# Bebas Neue, Permanent Marker, Caveat, Playfair Display, Roboto Mono (all Google Fonts, OFL).
# The FFmpeg overlay pre-renderer downloads the same files.
STUDIO_FONTS_BASE_URL=""

# If using Browserless.io for JS-rendered page scans (optional).
BROWSERLESS_API_KEY=""

# BACKLOG 13.37 — browser-render fallback for scans whose homepage is refused (403/429/503).
# Base URL of a self-hosted headless Chromium host running the open-source Browserless image
# (ghcr.io/browserless/chromium; POST /content — https://docs.browserless.io/enterprise/open-source).
# Unset = no fallback: a blocked scan fails and the user enters the profile manually (as before).
# Enabling it is an operator decision (runbooks/scan-blocked.md).
STUDIO_HEADLESS_RENDER_URL=""
# The host's TOKEN, when it sets one.
STUDIO_HEADLESS_RENDER_TOKEN=""


# -----------------------------------------------------------------------------
# Video library indexing (Feature A — optional, only if using Twelve Labs)
# -----------------------------------------------------------------------------

TWELVE_LABS_API_KEY=""


# -----------------------------------------------------------------------------
# Classifier configuration
# -----------------------------------------------------------------------------

# Default classifier: 'heuristic' (deterministic) or 'anthropic' (uses Claude)
STUDIO_CLASSIFIER="anthropic"

# Cost caps (in pence)
CLASSIFIER_DAILY_CAP_PER_ORG="500"
CLASSIFIER_DAILY_CAP_GLOBAL="10000"


# -----------------------------------------------------------------------------
# Queue and workers
# -----------------------------------------------------------------------------

BULLMQ_QUEUE_PREFIX="studio"
WORKER_CONCURRENCY_ORCHESTRATION="10"
WORKER_CONCURRENCY_ASSETS="15"
WORKER_CONCURRENCY_PUBLISH="5"
WORKER_CONCURRENCY_ANALYTICS="5"
# Video library ingestion (Feature A). Each job buffers up to 200 MB (≤ 200 MB × concurrency of
# RAM per worker): keep this low. STUDIO_LIBRARY_CONCURRENCY wins over the legacy
# WORKER_CONCURRENCY_LIBRARY; capped at 32. Throughput math: runbooks/corpus-ingestion.md
STUDIO_LIBRARY_CONCURRENCY="2"
WORKER_CONCURRENCY_LIBRARY="2"
# Plan tier corpus ingestion runs under (routing, queue priority and the platform org's cost
# caps: BASIC|STANDARD|PLUS|ENTERPRISE, default STANDARD). The full 50k run needs a tier whose
# daily/monthly caps cover the spend — see runbooks/corpus-ingestion.md "Cost".
STUDIO_LIBRARY_PLAN_TIER="STANDARD"
WORKER_MAX_JOBS_PER_WORKER="10000"


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
# 0 disables performance tracing (errors are still reported).
SENTRY_TRACES_SAMPLE_RATE="0"

# Prometheus scrapes: GET /api/metrics (API) and :WORKER_METRICS_PORT/metrics (worker), both with
# "Authorization: Bearer $METRICS_TOKEN". Unset = endpoints disabled (404). Private ingress only.
METRICS_TOKEN=""

# Organisation ids of PostMind staff (comma-separated). Admin endpoints (kill switch, cost,
# library admin) also require the caller's organisation to be listed. Unset = admin endpoints
# refused in production.
STUDIO_PLATFORM_ORG_IDS=""
WORKER_METRICS_PORT="9464"

# API request limits per one-minute window (Redis, after authentication). Exceeding one returns
# 429 with Retry-After. Unset = defaults (reads 600/user, writes 120/user, 3000/organisation).
STUDIO_RATE_LIMIT_READS_PER_MIN=""
STUDIO_RATE_LIMIT_WRITES_PER_MIN=""
STUDIO_RATE_LIMIT_ORG_PER_MIN=""

# Review checkpoint (spec 5.9): an AUTO_APPROVE project is approved automatically only when its
# creator already has at least this many videos in the organisation approved by a person (and the
# run is clean; never for ENTERPRISE). Integer 1–1000; unset = 10. Invalid = auto-approve off.
# A per-organisation policy set in Admin → Organisations (13.18) overrides this for that org.
STUDIO_AUTO_APPROVE_TRUST_THRESHOLD=""

# Provider circuit breaker store (13.16): "redis" (default when REDIS_URL is set) shares breaker
# state between every worker and API process; "memory" keeps it per process. With "redis", a
# Redis outage falls back to per-process state automatically (fail-safe).
STUDIO_CIRCUIT_BREAKER_STORE=""

LOG_LEVEL="info"


# -----------------------------------------------------------------------------
# Feature flags (per-environment overrides)
# -----------------------------------------------------------------------------

FEATURE_LIBRARY_ENABLED="true"
FEATURE_OVERLAYS_ENABLED="true"
FEATURE_SLIDESHOW_ENABLED="true"
FEATURE_IMAGE_LIBRARY_ENABLED="true"


# -----------------------------------------------------------------------------
# Cost tracking
# -----------------------------------------------------------------------------

# Providers bill in USD; Studio records GBP pence. Update when finance revises the rate.
STUDIO_USD_TO_GBP_RATE="0.75"

# Cost caps (spec 12.5), GBP pence of provider spend. Each cap alerts once at 80% and 100%
# (studio.cost_alerts, metric studio_cost_alerts_total, audit, notification).
# The org daily / org monthly / global caps have operator-decided defaults in code
# (src/lib/studio/cost/caps.ts, operator decision 2 of 2026-09-27):
#   empty            → the default below (shown in the comment)
#   positive integer → overrides the default
#   "0" / "none" / "off" → disables that cap (no cap at all)
# Per-project caps are video_projects.costBudgetPence: generation pauses at 90% of it. A project
# created without one gets 350 (short-form) or 3000 (long-form: any target > 180 s, or a YouTube
# upload > 60 s) — cost/project-budget.ts; not configurable by env.
# Hard ceiling per organisation per provider (spec 11.4): that provider is skipped at 100%.
# No default: empty = no cap ("0" here is a zero cap, not "disabled").
STUDIO_ORG_PROVIDER_DAILY_CAP_PENCE=""
# Per organisation per UTC day, all providers, by plan tier (BASIC | STANDARD | PLUS | ENTERPRISE
# from Core's organisation context). At 100% new generation pauses until midnight UTC;
# publishing continues. Defaults: 1000 / 3000 / 7500 / 40000 (£10 / £30 / £75 / £400).
STUDIO_ORG_DAILY_CAP_PENCE_BASIC=""
STUDIO_ORG_DAILY_CAP_PENCE_STANDARD=""
STUDIO_ORG_DAILY_CAP_PENCE_PLUS=""
STUDIO_ORG_DAILY_CAP_PENCE_ENTERPRISE=""
# Per organisation per calendar month (UTC), all providers, by plan tier. At 100% new generation
# pauses until the 1st (UTC); publishing continues.
# Defaults: 4000 / 15000 / 45000 / 300000 (£40 / £150 / £450 / £3,000).
STUDIO_ORG_MONTHLY_CAP_PENCE_BASIC=""
STUDIO_ORG_MONTHLY_CAP_PENCE_STANDARD=""
STUDIO_ORG_MONTHLY_CAP_PENCE_PLUS=""
STUDIO_ORG_MONTHLY_CAP_PENCE_ENTERPRISE=""
# Every organisation together per UTC day (Studio-owned provider budgets). At 100% all
# generation pauses. Default: 250000 (£2,500).
STUDIO_GLOBAL_DAILY_CAP_PENCE=""

# -----------------------------------------------------------------------------
# Notifications (spec 14.4)
# -----------------------------------------------------------------------------

# In-app notifications are always stored (GET /api/studio/notifications). Optionally, every
# notification is also POSTed to this webhook so ops can bridge it to PostMind Core, email or
# Slack. Signed: X-Studio-Timestamp + X-Studio-Signature: v1=<hex HMAC-SHA256(secret,
# "<timestamp>.<body>")>. Payload documented in src/lib/studio/notifications/sender.ts.
# Email: see STUDIO_EMAIL_PROVIDER below.
STUDIO_NOTIFY_WEBHOOK_URL=""
# Required (≥16 characters) when the URL is set.
STUDIO_NOTIFY_WEBHOOK_SECRET=""

# BACKLOG 13.33 — email for users who enabled it per kind (notification preferences).
# Unset / "none" = no sender: opted-in email is recorded as "pending_setup".
# "core" = PostMind Core sends it (CoreEmailSender) — Core has no email API yet, so this still
# records "pending_setup". "resend" / "ses" are refused until the operator decides Studio sends
# email itself and that adapter is built (runbooks/notifications-email.md).
STUDIO_EMAIL_PROVIDER=""

# -----------------------------------------------------------------------------
# Media tools (worker hosts)
# -----------------------------------------------------------------------------

# ffmpeg/ffprobe are required by compose-video (probing renders) and the quality gate
# (black frames, loudness). Leave empty to use the binaries on PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
