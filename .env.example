# =============================================================================
# PostMind Studio — Environment Variables
# =============================================================================
# Copy this file to .env.local and populate with real values.
# .env.local is git-ignored. NEVER commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Core service
# -----------------------------------------------------------------------------

# Postgres connection string. Use the studio schema.
# Format: postgres://user:pw@host:5432/dbname?schema=studio
DATABASE_URL="postgresql://studio:studio@localhost:5432/postmind?schema=studio"

# Redis connection URL for BullMQ. Studio uses DB 3 by convention.
REDIS_URL="redis://localhost:6379/3"

# Runtime mode. Affects logging verbosity and Prisma query logs.
NODE_ENV="development"

# HTTP port. Defaults to 3010 (Studio) to avoid clash with PostMind Core on 3000.
PORT="3010"

# Public base URL of the service.
APP_URL="http://localhost:3010"

# Deployment: Render only (render.yaml, runbooks/render-deploy.md). Leave empty locally.
# Render's plain Postgres connectionString (Blueprint fromDatabase). scripts/render/with-db-url.sh
# turns it into DATABASE_URL (adds schema=studio, connection_limit, pool_timeout,
# application_name) before starting the web, a worker or the pre-deploy migration.
RENDER_POSTGRES_URL=""
# Prisma pool size per process (1–100), set per Render service so the total stays under the
# Postgres plan's connection limit. Empty = Prisma's default (num_cpus * 2 + 1).
STUDIO_DB_CONNECTION_LIMIT=""
# Seconds to wait for a pooled connection (0–300). Empty = Prisma's default (10).
STUDIO_DB_POOL_TIMEOUT=""


# -----------------------------------------------------------------------------
# Phase 18 — standalone SaaS: modes (plans/phase-18.md §0)
# -----------------------------------------------------------------------------

# "standalone" (default): Studio's own sign-in (Better Auth), Stripe billing, Resend email,
# local businesses and audit log; the PostMind Core variables below are OPTIONAL.
# "core": the pre-Phase-18 behaviour (Core's JWT, context, audit, billing); Core vars REQUIRED.
# Production refuses to start when a key its mode needs is missing (src/lib/env.ts).
STUDIO_MODE="standalone"
# Optional per-integration overrides (empty = the STUDIO_MODE default):
# standalone | core
STUDIO_IDENTITY_MODE=""
# local | core | both
STUDIO_AUDIT_SINK=""
# stripe | core
STUDIO_BILLING=""
# local | core
STUDIO_BUSINESSES=""
# studio | core
STUDIO_META_CONNECT=""

# -----------------------------------------------------------------------------
# Phase 18 — sign-in (Better Auth, §2.1–§2.5; runbooks/auth.md)
# -----------------------------------------------------------------------------

# REQUIRED in standalone. ≥32 random characters; signs session cookies and encrypts 2FA secrets.
# Generate with: openssl rand -hex 32. Rotation: runbooks/auth.md.
BETTER_AUTH_SECRET=""
# Public URL of the auth endpoints; the same origin as APP_URL. Empty = APP_URL.
BETTER_AUTH_URL=""
# Optional: Google sign-in ("Continue with Google" is hidden while unset). A separate OAuth client
# from the YouTube publishing one; redirect ${APP_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# false = invite-only (the sign-up page is closed; invitations still work). Default true.
STUDIO_SIGNUPS_ENABLED="true"
# Reject passwords found in the Have I Been Pwned k-anonymity range API. Fails open (logged).
STUDIO_HIBP_CHECK="true"
# Client IP for auth rate limits. Empty (the VPS default) = the X-Real-IP header, which Caddy sets
# to its client_ip (deploy/vps/caddy/site.caddy.tmpl); X-Forwarded-For is ignored. Behind another
# proxy that only appends X-Forwarded-For, list its addresses (IPs or CIDRs, comma-separated):
# the chain is then walked right to left past them.
STUDIO_AUTH_TRUSTED_PROXIES=""
# Superadmin impersonation (§2.5). Off by default; when on it is read-only unless WRITE is true.
STUDIO_IMPERSONATION_ENABLED="false"
STUDIO_IMPERSONATION_WRITE="false"
# Days the local audit log is kept (§2.6). Default 730 (2 years).
STUDIO_AUDIT_RETENTION_DAYS="730"

# -----------------------------------------------------------------------------
# Phase 18 — billing (Stripe, §2.7; runbooks/billing-stripe.md)
# -----------------------------------------------------------------------------

# REQUIRED when STUDIO_BILLING=stripe (the standalone default). Test mode: sk_test_…; the
# webhook secret is the endpoint's signing secret (or the one `stripe listen` prints locally).
# Studio pins Stripe API version 2026-08-26.dahlia (src/lib/studio/billing/stripe-client.ts).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: the Customer Portal configuration created by scripts/billing/portal-config.ts.
STRIPE_PORTAL_CONFIGURATION_ID=""
# Trial length of the STANDARD trial and the failed-payment grace period, in days.
STUDIO_TRIAL_DAYS="14"
STUDIO_BILLING_GRACE_DAYS="7"
# Days a cancelled organisation stays read-only before the purge starts; 0 disables auto-purge.
STUDIO_CANCELLED_RETENTION_DAYS="90"

# -----------------------------------------------------------------------------
# Phase 18 — transactional email (Resend, §2.8; runbooks/email-resend.md)
# -----------------------------------------------------------------------------

# REQUIRED when STUDIO_EMAIL_PROVIDER=resend (the standalone default).
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# e.g. "PostMind Studio <no-reply@mail.example.com>" on a domain verified in Resend.
STUDIO_EMAIL_FROM=""
STUDIO_EMAIL_REPLY_TO=""
# ≥32 characters; signs the one-click unsubscribe links (RFC 8058).
STUDIO_UNSUBSCRIBE_SECRET=""
# STUDIO_SUPPORT_EMAIL (contact section below) is shown in every email footer when set.
# Per-source-address limit for the Resend (and Stripe) webhooks; default 600 per minute.
STUDIO_WEBHOOK_RATE_LIMIT_PER_MIN=""

# -----------------------------------------------------------------------------
# Phase 18 — Meta connect (Facebook Login for Business, §2.10; runbooks/meta-connect.md)
# -----------------------------------------------------------------------------

# META_APP_ID / META_APP_SECRET are in "Platforms" below (Studio's OWN Business-type Meta app in
# standalone mode). The Facebook Login for Business configuration id (holds the permissions and
# asset types). Meta "Connect" is hidden while any of the three is unset.
META_LOGIN_CONFIG_ID=""
# Graph version of the login and token exchange (falls back to META_GRAPH_API_VERSION).
META_GRAPH_VERSION="v26.0"
# Optional: the OAuth redirect registered in the app ("Valid OAuth Redirect URIs"). Default
# ${APP_URL}/api/studio/platform-connections/oauth-callback. Also register the callbacks
# ${APP_URL}/api/meta/deauthorize and ${APP_URL}/api/meta/data-deletion (runbooks/meta-connect.md).
META_REDIRECT_URI=""

# -----------------------------------------------------------------------------
# Phase 18 — business details shown to customers
# -----------------------------------------------------------------------------

# Enterprise "Contact us", the "we can't email you" support contact, the legal pages.
STUDIO_SALES_EMAIL=""
STUDIO_SUPPORT_EMAIL=""
STUDIO_LEGAL_ENTITY_NAME=""


# -----------------------------------------------------------------------------
# PostMind Core integration — REQUIRED only when STUDIO_MODE=core (optional in standalone)
# -----------------------------------------------------------------------------

# Base URL of the PostMind Core API for tenant/user context lookups.
POSTMIND_CORE_URL="http://localhost:3000"

# JWKS endpoint of PostMind Core's auth service. Used to verify JWTs.
POSTMIND_JWKS_URL="http://localhost:3000/.well-known/jwks.json"

# Expected JWT issuer claim. Reject tokens with any other iss.
POSTMIND_JWT_ISSUER="postmind-core"

# Expected JWT audience claim. Reject tokens with any other aud.
POSTMIND_JWT_AUDIENCE="postmind-studio"

# Browser UI (BACKLOG 10.2): name of PostMind's session cookie that carries the JWT when the
# studio.postmind.ai pages call the API. Requires Studio to share the cookie domain with Core.
# Unset = only Authorization: Bearer is accepted.
POSTMIND_SESSION_COOKIE=""

# Long-lived shared secret for service-to-service calls. Rotate quarterly.
# Generate with: openssl rand -hex 32
POSTMIND_SERVICE_TOKEN=""

# Audit ingest endpoint URL.
POSTMIND_AUDIT_URL="http://localhost:3000/api/internal/audit"


# -----------------------------------------------------------------------------
# Object storage (S3-compatible)
# -----------------------------------------------------------------------------

# Storage provider for the object buckets: "s3" (AWS S3, the default) or "r2" (Cloudflare R2).
# Validated at first storage use (src/lib/studio/storage-client.ts); a bad value fails fast.
# KMS is NOT affected: KMS_KEY_ID keeps using AWS_REGION + the AWS_* credentials below on both.
# R2 setup (buckets, token, CORS, lifecycle): runbooks/r2-setup.md.
STORAGE_PROVIDER="s3"

# AWS region + credentials: S3 storage (STORAGE_PROVIDER=s3) and KMS (always).
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudflare R2 (only read when STORAGE_PROVIDER=r2; all but R2_JURISDICTION are then required).
# Account id: Cloudflare dashboard > R2 > Account Details. Endpoint used:
# https://<R2_ACCOUNT_ID>[.<R2_JURISDICTION>].r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
# eu | us | fedramp, matching the jurisdiction the buckets were CREATED in (cannot change later;
# a jurisdiction endpoint only reaches that jurisdiction's buckets). Empty = no jurisdiction.
R2_JURISDICTION=""
# Access Key ID + Secret Access Key of an R2 API token with Object Read & Write, scoped to the
# Studio buckets (the app never needs Admin; lifecycle changes use a separate Admin token).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Bucket names (create these first, or use different names in dev). With STORAGE_PROVIDER=r2
# these are the R2 bucket names (the S3_* names are kept for both providers).
S3_BUCKET_ASSETS="studio-assets-dev"
S3_BUCKET_RENDERS="studio-renders-dev"
S3_BUCKET_THUMBNAILS="studio-thumbnails-dev"
# 15.A5 (spec 9.9): minutes between platforms when a scheduled / drip video goes out (15–60).
STUDIO_DEFAULT_STAGGER_MINUTES="30"
# 20.9 "Plan my month" runner (services/content-plan-run.ts). Posts of one plan generating at once
# (1–10, default 2), and posts started per UTC day across the platform: a positive integer or
# "unlimited"; empty = unlimited.
STUDIO_CONTENT_PLAN_CONCURRENCY=""
STUDIO_CONTENT_PLAN_DAILY_STARTS=""
S3_BUCKET_LIBRARY="studio-library-assets-dev"
# 15.E9 (spec 4.6) secondary-region storage fallback. Unset S3_FALLBACK_REGION = no failover.
# Each S3_FALLBACK_BUCKET_* maps the primary bucket above to a bucket in the fallback region;
# DevOps creates them (runbooks/storage-failover.md). With STORAGE_PROVIDER=r2,
# S3_FALLBACK_REGION is "auto" (fallback buckets reached through the same R2 endpoint) or the
# fallback buckets' jurisdiction (eu | us | fedramp).
S3_FALLBACK_REGION=""
S3_FALLBACK_BUCKET_ASSETS=""
S3_FALLBACK_BUCKET_RENDERS=""
S3_FALLBACK_BUCKET_THUMBNAILS=""
S3_FALLBACK_BUCKET_LIBRARY=""
# Phase 17.5 backup copy (scripts/ops/backup-storage.ts; Render cron studio-backup-storage-<env>;
# runbooks/backup-recovery.md). Only the backup job reads these; the app never does. ONE backup
# bucket holds every live bucket under a prefix (assets/, renders/, thumbnails/). It must not be a
# live or fallback bucket, and on S3 must not be versioned (deleted copies must really go).
S3_BACKUP_BUCKET=""
# S3: the backup bucket's AWS region (default AWS_REGION). R2: "auto" (same endpoint as the live
# buckets, default) or its jurisdiction (eu | us | fedramp). Same endpoint = server-side
# CopyObject; another endpoint = streamed GET → PUT through the job.
S3_BACKUP_REGION=""
# Days a backup copy is kept after its source was deleted (organisation hard delete, business
# purge, lifecycle expiry): 1–30, default 30. Never longer than 30: purged data must age out.
S3_BACKUP_RETENTION_DAYS="30"
# The backup job's own key pair (both or neither; neither = the storage credentials above). R2:
# a token with read on the live buckets and read & write on the backup bucket (r2-setup.md).
S3_BACKUP_ACCESS_KEY_ID=""
S3_BACKUP_SECRET_ACCESS_KEY=""
# s3:// corpus sources for POST /admin/library/ingest: comma-separated `bucket` or
# `bucket/prefix/` entries Studio's storage credentials may read. Empty = s3:// refused (https://
# sources are always fetched through the SSRF guard). runbooks/corpus-ingestion.md
STUDIO_CORPUS_S3_BUCKETS=""

# CloudFront distribution URL for signed CDN URLs (optional in dev). When set, the key pair
# below is REQUIRED and objects in CDN_BUCKET are served as CloudFront signed URLs (canned
# policy, same expiry as the S3 presigned URLs); other buckets stay S3 presigned (13.30).
# S3 only: with STORAGE_PROVIDER=r2 leave CDN_URL empty (startup error otherwise); R2 objects
# are served as R2 presigned URLs (at most 7 days).
CDN_URL=""
# The S3 bucket behind the distribution (default: S3_BUCKET_RENDERS).
CDN_BUCKET=""
# CloudFront public key id from the distribution's trusted key group.
CLOUDFRONT_KEY_PAIR_ID=""
# Matching RSA private key, PEM (escaped newlines allowed on one line) — or base64 of the PEM below.
CLOUDFRONT_PRIVATE_KEY=""
CLOUDFRONT_PRIVATE_KEY_BASE64=""


# -----------------------------------------------------------------------------
# KMS (envelope encryption for platform tokens, voice profiles, BYOC keys)
# -----------------------------------------------------------------------------

KMS_KEY_ID=""

# Local development only (refused when NODE_ENV=production): when KMS_KEY_ID is empty,
# data keys are wrapped with this 32-byte base64 master key instead of KMS.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_LOCAL_MASTER_KEY=""


# -----------------------------------------------------------------------------
# Meta (Instagram + Facebook)
# -----------------------------------------------------------------------------
# Meta tokens. Standalone (STUDIO_META_CONNECT=studio): Studio's own Facebook Login for Business
# (runbooks/meta-connect.md); META_APP_SECRET also signs appsecret_proof and verifies Meta's
# signed_request callbacks. Core mode (operator decision 2026-09-27, Engagement handover 9.5 /
# 9.6 / 14.13 pattern): PostMind Core runs the Meta login and pushes page / IG tokens to Studio's
# internal endpoints
# (POST /api/studio/internal/channels, DELETE /api/studio/internal/channels/:id,
# POST /api/studio/internal/tokens/refreshed). Studio stores them envelope-encrypted (KMS_KEY_ID /
# STUDIO_LOCAL_MASTER_KEY) in studio.platform_connections and never refreshes them itself.

META_APP_ID=""
META_APP_SECRET=""
# Graph API version used by the Reels publishers (Graph API changelog, 2026).
META_GRAPH_API_VERSION="v26.0"

# Engagement internal API (auth: X-Service-Token = POSTMIND_SERVICE_TOKEN).
# Used for publication attribution (spec 16.3).
ENGAGEMENT_INTERNAL_URL="http://localhost:3001"

# INBOUND service token PostMind Core sends as X-Service-Token on /api/studio/internal/**.
# At least 32 characters (openssl rand -hex 32); compared in constant time. Unset or shorter =
# the internal endpoints answer 404 (disabled). Different from POSTMIND_SERVICE_TOKEN (outbound).
# The /api/studio/internal/* paths must be reachable ONLY from the private network: bind them to
# private ingress, never the public load balancer (Engagement handover 14.13).
STUDIO_INTERNAL_SERVICE_TOKEN=""
# Requests per minute Core may make to the internal endpoints (Redis window). Unset = 600.
STUDIO_INTERNAL_RATE_LIMIT_PER_MIN=""
# 15.E5 public share-link pages (/p/:token, no session): requests per minute per client address
# (reads default 60, feedback posts default 5) and per link from everyone (default 120).
STUDIO_PUBLIC_RATE_LIMIT_READS_PER_MIN=""
STUDIO_PUBLIC_RATE_LIMIT_WRITES_PER_MIN=""
STUDIO_PUBLIC_RATE_LIMIT_LINK_PER_MIN=""
# 15.W5: add ON_VIDEO_PUBLISHED trigger fields (hashtags, project tags) to the Engagement
# attribution call. Default off until Engagement confirms the proposed contract.
STUDIO_ENGAGEMENT_TRIGGER_FIELDS=""
# BACKLOG 14.1 — days between Core's organisation purge (soft delete) and the daily hard delete of
# the organisation's rows and S3 objects (Engagement handover 14.13: 30). Whole days, 1–365.
# Unset = 30. Applies to purges requested after the change (graceUntil is fixed at request time).
STUDIO_PURGE_GRACE_DAYS=""
# BACKLOG 17.1 — hours after an upload's presigned PUT URL expired before the daily sweep deletes
# a browser upload that was never completed (its object and a FAILED row). Whole hours, 1–720.
# Unset = 24. READY uploads and anything a project, slide or brand kit references are never swept.
STUDIO_UPLOAD_ABANDON_GRACE_HOURS=""
# BACKLOG 17.2 — minutes a SCHEDULED publication may be overdue (and unchanged) before the
# 10-minute sweep treats its publish job as lost and re-enqueues it once. Whole minutes, 5–1440.
# Unset = 15 (covers the gap between the commit and the enqueue, and a busy queue).
STUDIO_LOST_PUBLISH_MARGIN_MINUTES=""
# BACKLOG 17.3 — daily platform account-status check (hourly job; each active connection at most
# once per interval). Interval in hours (1–168, unset = 24), connections per hourly run (1–1000,
# unset = 100) and the pause between two platform calls in ms (0–60000, unset = 2000).
STUDIO_ACCOUNT_CHECK_INTERVAL_HOURS=""
STUDIO_ACCOUNT_CHECK_BATCH=""
STUDIO_ACCOUNT_CHECK_SPACING_MS=""
# BACKLOG 14.10 — only for `npm run contract:core` (the Core contract suite, run against STAGING,
# never production): Studio staging's private base URL and its STUDIO_INTERNAL_SERVICE_TOKEN.
# Or pass --base-url / --token. See integrations/core/README.md.
STUDIO_CONTRACT_BASE_URL=""
STUDIO_CONTRACT_TOKEN=""


