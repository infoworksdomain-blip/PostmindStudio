SYNTHESIA_API_KEY=""

DID_API_KEY=""

TAVUS_API_KEY=""


# -----------------------------------------------------------------------------
# AI providers — voice
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL="eleven_multilingual_v2"
# Any voice id from your ElevenLabs voice library. Used by scripts/test-elevenlabs.ts only;
# production voices come from voice_profiles / brand kits.
ELEVENLABS_VOICE_ID=""
# Narration voice when a brand kit has no cloned voice (spec 5.5). Required for voiceover.
ELEVENLABS_DEFAULT_VOICE_ID=""
# 15.C5: optional default narration voice per script language (a native-accent voice), used
# after a brand clone and a tone-matched stock voice, before ELEVENLABS_DEFAULT_VOICE_ID. Key =
# the language tag upper-cased with "-" → "_"; a base-language key (e.g. _PT, _EN) also works.
# Voice ids: ElevenLabs app → Voices → Voice Library (filter by language) → add → "Copy voice
# ID", or GET /v2/voices. Unset = the global default (multilingual voices speak every Studio
# language with eleven_multilingual_v2 / eleven_flash_v2_5 / eleven_v3).
ELEVENLABS_DEFAULT_VOICE_ID_EN_GB=""
ELEVENLABS_DEFAULT_VOICE_ID_EN_US=""
ELEVENLABS_DEFAULT_VOICE_ID_FR=""
ELEVENLABS_DEFAULT_VOICE_ID_ES=""
ELEVENLABS_DEFAULT_VOICE_ID_AR=""
ELEVENLABS_DEFAULT_VOICE_ID_DE=""
ELEVENLABS_DEFAULT_VOICE_ID_IT=""
ELEVENLABS_DEFAULT_VOICE_ID_PT_BR=""
ELEVENLABS_DEFAULT_VOICE_ID_PT_PT=""
ELEVENLABS_DEFAULT_VOICE_ID_HI=""
ELEVENLABS_DEFAULT_VOICE_ID_ZH_HANS=""
# 15.B3 (spec 5.5 "one of five pre-selected ElevenLabs voices matched to the brand's declared
# tone"): comma-separated tone=voiceId pairs, matched against brand_kits.toneKeywords, e.g.
# warm=<id>,energetic=<id>,professional=<id>,playful=<id>,calm=<id>. `tone@fr=<id>` limits a
# voice to one language. Voice ids from ElevenLabs → Voices (or GET /v2/voices). Unset = no stock
# voice step (brand clone → language default → ELEVENLABS_DEFAULT_VOICE_ID).
STUDIO_STOCK_VOICES=""
# 13.13 voice cloning (ElevenLabs Instant Voice Cloning, uses ELEVENLABS_API_KEY): lowest plan
# tier allowed to clone a voice. Operator decision P4 (2026-09-28, Playbook A-06): Plus and
# Enterprise (spec 12.4 lists "brand voice clone" under Plus). BASIC | STANDARD | PLUS |
# ENTERPRISE (default PLUS).
STUDIO_VOICE_CLONE_MIN_TIER="PLUS"

# Azure Speech (fallback)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="uksouth"


# -----------------------------------------------------------------------------
# AI providers — music (Layer 5)
# -----------------------------------------------------------------------------
# ElevenLabs Music replaces Suno (no public API). It uses ELEVENLABS_API_KEY above; the account
# must be on a paid plan (Starter+ for commercial use; https://elevenlabs.io/pricing/api,
# $0.15 per generated minute). Registered as provider `elevenlabs-music` whenever the key is set.
# Model: music_v1 | music_v2 | music_v2_5 (https://elevenlabs.io/docs/api-reference/music/compose).
ELEVENLABS_MUSIC_MODEL="music_v2_5"
# Lowest plan tier that gets a generated track: BASIC | STANDARD | PLUS | ENTERPRISE.
# Default STANDARD — spec 12.4 lists no music for Basic, so Basic renders are narration-only.
STUDIO_MUSIC_MIN_TIER="STANDARD"

# P7 (Addendum A3.6 step 3): per-business provider ratings (approval rate, regeneration rate,
# retention of each provider's shots over 90 days) reorder the router's candidates within a
# plan tier's list. "on" (default) or "off". Visible at GET /api/studio/businesses/:id/provider-ratings.
STUDIO_PROVIDER_RATINGS="on"

# P1 BYOC (spec 6.6 / 12.6): Enterprise organisations may store their own provider API keys
# (/api/studio/provider-credentials, envelope-encrypted with KMS_KEY_ID / STUDIO_LOCAL_MASTER_KEY);
# their provider calls then use those keys. "true" to enable; default off (the list answers
# { enabled: false, reason: "disabled" }, mutations 403 feature_disabled; non-Enterprise 403 plan_tier).
STUDIO_BYOC_ENABLED="false"


# -----------------------------------------------------------------------------
# Stock media
# -----------------------------------------------------------------------------

# Also enable Layer 5 sound effects (storyblocks-audio adapter, content_type=sfx; 13.27).
STORYBLOCKS_API_PUBLIC_KEY=""
STORYBLOCKS_API_PRIVATE_KEY=""

PEXELS_API_KEY=""

UNSPLASH_ACCESS_KEY=""


# -----------------------------------------------------------------------------
# Composition
# -----------------------------------------------------------------------------

SHOTSTACK_API_KEY=""
# "stage" = watermarked sandbox, "v1" = production. Keys differ per environment.
SHOTSTACK_ENVIRONMENT="stage"

CREATOMATE_API_KEY=""


# -----------------------------------------------------------------------------
# Captions
# -----------------------------------------------------------------------------

ASSEMBLYAI_API_KEY=""
# "us" (default, api.assemblyai.com) or "eu" (api.eu.assemblyai.com) for EU data residency.
ASSEMBLYAI_REGION="us"


# -----------------------------------------------------------------------------
# Content safety
# -----------------------------------------------------------------------------

# No content-safety provider is used (20.21, operator decision 2026-10-02: Hive removed). The
# quality gate records content safety as "Not scanned" and every video goes on to the normal
# review; there are no content-safety keys to set.
# BACKLOG 14.11 — videos sampled each month for the Trust & Safety audit (1–500, default 50;
# runbooks/content-safety-miss.md).
STUDIO_SAFETY_AUDIT_SAMPLE="50"

SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""


# -----------------------------------------------------------------------------
# Website scanning (Feature D)
# -----------------------------------------------------------------------------

# Text overlays (Feature B). Shotstack has no system fonts: every font a render names is fetched
# as <FamilyWithoutSpaces>.ttf from this URL (the FFmpeg pre-renderer and thumbnails too).
# OPTIONAL (20.7): empty = ${APP_URL}/fonts, the files Studio ships in public/fonts/ (every preset,
# onboarding and Noto family; list, sources and licences in public/fonts/SOURCES.md). Set it only
# for a CDN or a host with extra brand families (it must then serve those files too). Shotstack
# fetches them from the internet, so APP_URL must be public (not localhost) for real renders.
# Arabic pre-renders need FFmpeg built with --enable-libfribidi (runbooks/deploy.md).
STUDIO_FONTS_BASE_URL=""
# Operator decision P2: optional https image shown as a short end card on outputs of
# organisations that are NOT white-label (never on ENTERPRISE or org_policies.whiteLabel). Unset =
# Studio adds no mark of its own.
STUDIO_MADE_WITH_CARD_URL=""

# If using Browserless.io for JS-rendered page scans (optional).
BROWSERLESS_API_KEY=""

# BACKLOG 13.37 — browser-render fallback for scans whose homepage is refused (403/429/503).
# Base URL of a self-hosted headless Chromium host running the open-source Browserless image
# (ghcr.io/browserless/chromium; POST /content — https://docs.browserless.io/enterprise/open-source).
# Unset = no fallback: a blocked scan fails and the user enters the profile manually (as before).
# Enabling it is an operator decision (runbooks/scan-blocked.md).
# BACKLOG 14.4: docker-compose.prod.yml runs it behind the `headless-render` profile
# (http://browserless:3000), and it is only used for scans whose owner confirmed ownership.
STUDIO_HEADLESS_RENDER_URL=""
# The host's TOKEN, when it sets one (sent as "Authorization: Bearer", never in the URL). With the
# compose service it must equal the contents of BROWSERLESS_TOKEN_FILE (deploy host only).
STUDIO_HEADLESS_RENDER_TOKEN=""


# -----------------------------------------------------------------------------
# Video library indexing (Feature A — optional, only if using Twelve Labs)
# -----------------------------------------------------------------------------

TWELVE_LABS_API_KEY=""


# -----------------------------------------------------------------------------
# Classifier configuration
# -----------------------------------------------------------------------------

# Default classifier: 'heuristic' (deterministic) or 'anthropic' (uses Claude)
STUDIO_CLASSIFIER="anthropic"

# Cost caps (in pence)
CLASSIFIER_DAILY_CAP_PER_ORG="500"
CLASSIFIER_DAILY_CAP_GLOBAL="10000"


# -----------------------------------------------------------------------------
# Queue and workers
# -----------------------------------------------------------------------------

BULLMQ_QUEUE_PREFIX="studio"
WORKER_CONCURRENCY_ORCHESTRATION="10"
WORKER_CONCURRENCY_ASSETS="15"
WORKER_CONCURRENCY_PUBLISH="5"
WORKER_CONCURRENCY_ANALYTICS="5"
# Video library ingestion (Feature A). Each job buffers up to 200 MB (≤ 200 MB × concurrency of
# RAM per worker): keep this low. STUDIO_LIBRARY_CONCURRENCY wins over the legacy
# WORKER_CONCURRENCY_LIBRARY; capped at 32. Throughput math: runbooks/corpus-ingestion.md
STUDIO_LIBRARY_CONCURRENCY="2"
WORKER_CONCURRENCY_LIBRARY="2"
# Phase 18 §2.8: studio-email (send-email jobs to Resend). Default 5.
WORKER_CONCURRENCY_EMAIL="5"
# Plan tier corpus ingestion runs under (routing, queue priority and the platform org's cost
# caps: BASIC|STANDARD|PLUS|ENTERPRISE, default STANDARD). The full 50k run needs a tier whose
# daily/monthly caps cover the spend — see runbooks/corpus-ingestion.md "Cost".
STUDIO_LIBRARY_PLAN_TIER="STANDARD"
# 20.15: shared video-library read cache in Redis (DB 3). On whenever REDIS_URL is set; "off"
# sends every library read to the database. See runbooks/corpus-ingestion.md "Library caching".
STUDIO_LIBRARY_CACHE=""
WORKER_MAX_JOBS_PER_WORKER="10000"


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
# 0 disables performance tracing (errors are still reported).
SENTRY_TRACES_SAMPLE_RATE="0"

# Prometheus scrapes: GET /api/metrics (API) and :WORKER_METRICS_PORT/metrics (worker), both with
# "Authorization: Bearer $METRICS_TOKEN". Unset = endpoints disabled (404). Private ingress only.
METRICS_TOKEN=""

# Organisation ids of PostMind staff (comma-separated). Admin endpoints (kill switch, cost,
# library admin) also require the caller's organisation to be listed. Unset = admin endpoints
# refused in production.
STUDIO_PLATFORM_ORG_IDS=""
# BACKLOG 15.D6 / spec 19.2: engaging the GLOBAL kill switch needs two staff members (a request,
# then a different person confirms within 10 minutes). Break-glass only: "true" lets one person
# engage it at once; every such engage is audited with breakGlass: true. Leave unset/false.
STUDIO_KILL_SWITCH_SINGLE_APPROVER="false"
WORKER_METRICS_PORT="9464"

# API request limits per one-minute window (Redis, after authentication). Exceeding one returns
# 429 with Retry-After. Unset = defaults (reads 600/user, writes 120/user, 3000/organisation).
STUDIO_RATE_LIMIT_READS_PER_MIN=""
STUDIO_RATE_LIMIT_WRITES_PER_MIN=""
STUDIO_RATE_LIMIT_ORG_PER_MIN=""

# Review checkpoint (spec 5.9): an AUTO_APPROVE project is approved automatically only when its
# creator already has at least this many videos in the organisation approved by a person (and the
# run is clean; never for ENTERPRISE). Integer 1–1000; unset = 10. Invalid = auto-approve off.
# A per-organisation policy set in Admin → Organisations (13.18) overrides this for that org.
STUDIO_AUTO_APPROVE_TRUST_THRESHOLD=""

# Provider circuit breaker store (13.16): "redis" (default when REDIS_URL is set) shares breaker
# state between every worker and API process; "memory" keeps it per process. With "redis", a
# Redis outage falls back to per-process state automatically (fail-safe).
STUDIO_CIRCUIT_BREAKER_STORE=""

LOG_LEVEL="info"


# -----------------------------------------------------------------------------
# Feature flags (per-environment overrides)
# -----------------------------------------------------------------------------
# 15.D1 / A12.4: "false" hard-disables the feature in this environment (users get 403
# feature_disabled, its jobs stop). Unset or "true" = on, and staff can then switch it off
# globally or per organisation from Admin → Features (system_flags studio.features.*; takes
# effect within 30 s). Any other value fails closed (off).

FEATURE_LIBRARY_ENABLED="true"
FEATURE_OVERLAYS_ENABLED="true"
FEATURE_SLIDESHOW_ENABLED="true"
FEATURE_IMAGE_LIBRARY_ENABLED="true"

# -----------------------------------------------------------------------------
# Plan tier gates, caps and quotas (15.D2, decision P3)
# -----------------------------------------------------------------------------
# A10.3 tier gates are fixed in code (services/tier-gates.ts). A10.4 caps:
# STUDIO_SCAN_COST_CAP_PENCE — one website scan's hard cost cap (default 50 = £0.50).
# STUDIO_IMAGE_GEN_MONTHLY_CAP_<BASIC|STANDARD|PLUS|ENTERPRISE> — generated images per business
#   per calendar month (defaults 20 / 50 / 200 / 1000).
# Spec 12.4 monthly video quotas per organisation (UTC calendar month):
# STUDIO_QUOTA_MODE — "warn" (in-app alerts at 80%/100% + banner, nothing blocked) or "enforce"
#   (also 403 quota_exceeded on generate and publish). Unset: "enforce" when Studio bills with
#   Stripe (STUDIO_BILLING=stripe, the standalone default — Phase 18 §6), "warn" in core mode.
#   Top-up credits are only spent in enforce mode.
# STUDIO_QUOTA_<TIER>_<SHORT|LONG|SHORT_MAX_SEC|LONG_MAX_SEC> — a number or "unlimited".
#   Defaults: Basic 20 short (≤30 s), 0 long; Standard 40 short, 1 long (≤180 s);
#   Plus 80 short, 4 long (≤360 s); Enterprise unlimited (price list 2026-09-30).
STUDIO_QUOTA_MODE=""
STUDIO_SCAN_COST_CAP_PENCE=""


# -----------------------------------------------------------------------------
# Cost tracking
# -----------------------------------------------------------------------------

# Providers bill in USD; Studio records GBP pence. Update when finance revises the rate.
STUDIO_USD_TO_GBP_RATE="0.75"

# Cost caps (spec 12.5), GBP pence of provider spend. Each cap alerts once at 80% and 100%
# (studio.cost_alerts, metric studio_cost_alerts_total, audit, notification).
# The org daily / org monthly / global caps have operator-decided defaults in code
# (src/lib/studio/cost/caps.ts, operator decision 2 of 2026-09-27):
#   empty            → the default below (shown in the comment)
#   positive integer → overrides the default
#   "0" / "none" / "off" → disables that cap (no cap at all)
# Per-project caps are video_projects.costBudgetPence: generation pauses at 90% of it. A project
# created without one gets 350 (short-form) or 3000 (long-form: any target > 180 s, or a YouTube
# upload > 60 s) — cost/project-budget.ts; not configurable by env.
# Hard ceiling per organisation per provider (spec 11.4): that provider is skipped at 100%.
# No default: empty = no cap ("0" here is a zero cap, not "disabled").
STUDIO_ORG_PROVIDER_DAILY_CAP_PENCE=""
# Per organisation per UTC day, all providers, by plan tier (BASIC | STANDARD | PLUS | ENTERPRISE
# from Core's organisation context). At 100% new generation pauses until midnight UTC;
# publishing continues. Defaults: 500 / 1500 / 4500 / 15000 (£5 / £15 / £45 / £150).
STUDIO_ORG_DAILY_CAP_PENCE_BASIC=""
STUDIO_ORG_DAILY_CAP_PENCE_STANDARD=""
STUDIO_ORG_DAILY_CAP_PENCE_PLUS=""
STUDIO_ORG_DAILY_CAP_PENCE_ENTERPRISE=""
# Per organisation per calendar month (UTC), all providers, by plan tier. At 100% new generation
# pauses until the 1st (UTC); publishing continues.
# Defaults: 2000 / 7300 / 26400 / 110000 (£20 / £73 / £264 / £1,100), from the plan catalogue
# (src/lib/studio/billing/catalogue.ts, price list 2026-09-30).
STUDIO_ORG_MONTHLY_CAP_PENCE_BASIC=""
STUDIO_ORG_MONTHLY_CAP_PENCE_STANDARD=""
STUDIO_ORG_MONTHLY_CAP_PENCE_PLUS=""
STUDIO_ORG_MONTHLY_CAP_PENCE_ENTERPRISE=""
# Every organisation together per UTC day (Studio-owned provider budgets). At 100% all
# generation pauses. Default: 250000 (£2,500).
STUDIO_GLOBAL_DAILY_CAP_PENCE=""

# -----------------------------------------------------------------------------
# Notifications (spec 14.4)
# -----------------------------------------------------------------------------

# In-app notifications are always stored (GET /api/studio/notifications). Optionally, every
# notification is also POSTed to this webhook so ops can bridge it to PostMind Core, email or
# Slack. Signed: X-Studio-Timestamp + X-Studio-Signature: v1=<hex HMAC-SHA256(secret,
# "<timestamp>.<body>")>. Payload documented in src/lib/studio/notifications/sender.ts.
# Email: see STUDIO_EMAIL_PROVIDER below.
STUDIO_NOTIFY_WEBHOOK_URL=""
# Required (≥16 characters) when the URL is set.
STUDIO_NOTIFY_WEBHOOK_SECRET=""

# BACKLOG 13.33 — email for users who enabled it per kind (notification preferences).
# Unset / "none" = no sender: opted-in email is recorded as "pending_setup".
# "core" = PostMind Core sends it (CoreEmailSender) — Core has no email API yet, so this still
# records "pending_setup". Phase 18: "resend" = Studio sends it through Resend (the standalone
# default when unset; see the Phase 18 email section above). Empty = the STUDIO_MODE default.
STUDIO_EMAIL_PROVIDER=""

# -----------------------------------------------------------------------------
# Media tools (worker hosts)
# -----------------------------------------------------------------------------

# ffmpeg/ffprobe are required by compose-video (probing renders) and the quality gate
# (black frames, loudness). Leave empty to use the binaries on PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
# Most ffmpeg/ffprobe children one process runs at once (1–64; src/lib/studio/pipeline/process-limit.ts).
# Unset = no cap. The single-server deployment sets 1 (deploy/vps/.env.example): its one worker runs
# every queue, and a 2 GB server has room for one FFmpeg at a time.
STUDIO_FFMPEG_MAX_CONCURRENT=""

# --- 15.D10 launch-readiness evals (operator-run: `npm run test:eval`, test/visual) -------------
# Not read by the app. runbooks/slo-and-launch-readiness.md. CI canary keys are GitHub secrets
# (CANARY_*), not env files.
# Staging deployment + a Core-issued JWT for the staging test org (A14.2 scan timing).
EVAL_STUDIO_BASE_URL=""
EVAL_STUDIO_TOKEN=""
# Optional overrides for the labelled manifests (default test/eval/fixtures/*.json).
EVAL_CLASSIFIER_MANIFEST=""
EVAL_SCAN_SITES=""
# Staging cost export for the A10 ±15% gate (default test/cost/fixtures/a10-actuals.json).
A10_ACTUALS_PATH=""
# Overlay pixel diff: folder of preset fonts as <Family>.ttf; pixel tolerance (default 0.02).
VISUAL_FONTS_DIR=""
VISUAL_MAX_DIFF_RATIO=""
# -----------------------------------------------------------------------------
# Staging gate (Phase 14.5–14.9, scripts/ops/staging-gate.ts, runbooks/staging-gate.md)
# -----------------------------------------------------------------------------
# Operator-run only: none of these are read by the app or the workers. In CI they come from the
# `staging` environment of .github/workflows/staging-gate.yml.

# 14.5 k6: the script reads BASE_URL + STUDIO_TOKEN (load-test org JWT); K6_BIN when k6 is not
# on PATH. METRICS_URL (staging /api/metrics, scraped with METRICS_TOKEN) adds the queue
# throughput section and is the global kill-switch drain signal.
K6_BIN=""
METRICS_URL=""
# 14.6 kill switch: a READ-ONLY role on the staging database times the scoped levels.
STAGING_DATABASE_URL=""
REHEARSE_WORKSPACE_ID=""
REHEARSE_PROJECT_ID=""
REHEARSE_PROVIDER="runway"
REHEARSE_PLATFORM="tiktok"
# 14.6 rollback: deploy command with {tag}; readiness URL (default STUDIO_URL/api/health/ready).
STAGING_DEPLOY_CMD=""
STAGING_READY_URL=""
ROLLBACK_FROM_TAG=""
ROLLBACK_TO_TAG=""
# 14.8 live providers + posts (npm run gate:live): public HTTPS media for AssemblyAI, a
# consented voice sample, a short MP4 (local path + a public URL for Meta), and one TEST account
# per platform: LIVE_<PLATFORM>_ACCESS_TOKEN / LIVE_<PLATFORM>_ACCOUNT_ID with PLATFORM one of
# TIKTOK, INSTAGRAM_REEL, YOUTUBE_SHORT, YOUTUBE, LINKEDIN_VIDEO, X, FACEBOOK.
LIVE_TEST_MEDIA_URL=""
LIVE_TEST_MEDIA_SEC="10"
LIVE_TEST_VOICE_SAMPLE_PATH=""
LIVE_TEST_VIDEO_PATH=""
LIVE_TEST_VIDEO_URL=""
LIVE_TEST_VIDEO_SEC="10"
LIVE_TEST_VIDEO_ASPECT="9:16"
LIVE_TIKTOK_ACCESS_TOKEN=""
LIVE_TIKTOK_ACCOUNT_ID=""
# Name recorded in the reports (CI uses the GitHub actor).
GATE_OPERATOR=""
