# =================================================================================================
# PostMind Studio — single-server (Hetzner VPS) environment file
# =================================================================================================
# Copy to the SERVER, never commit the filled-in copy:
#   production: /etc/postmind-studio/production.env
#   staging:    /etc/postmind-studio/staging.env        (only when you switch staging on)
# chmod 600, owned by the deploy user. runbooks/vps-deploy.md step 6 has a table with where every
# value comes from.
#
# This file is both the app's env file (web, worker, migrate) and the source docker compose
# interpolates deploy/vps/compose.yml from. Write secrets in SINGLE quotes: 'value'. Compose treats
# single-quoted values literally; unquoted and double-quoted values have ${…} interpolation
# applied (https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/,
# read 2026-09-29), which would corrupt a secret that contains "$".
#
# Set by compose.yml itself (do not add them here): DATABASE_URL (from POSTGRES_PASSWORD),
# REDIS_URL (redis://redis:6379/3), NODE_ENV, APP_URL (https://STUDIO_DOMAIN), the four *_REDIRECT_URI values, SENTRY_ENVIRONMENT (= STUDIO_ENV),
# WORKER_METRICS_PORT, NODE_OPTIONS.
#
# Backup credentials go in a SEPARATE file, /etc/postmind-studio/<env>.backup.env
# (deploy/vps/backup.env.example), so the app never sees them.
#
# Generate random values on the server with:  openssl rand -hex 32

# =================================================================================================
# REQUIRED — the deploy refuses to start without these
# =================================================================================================

# ---- This server and environment -------------------------------------------------------------------
# production | staging. Also the Caddy upstream name, the backup path and SENTRY_ENVIRONMENT.
STUDIO_ENV=production
# The public host name, e.g. studio.postmind.ai (staging: studio-staging.postmind.ai). DNS A record
# must point at the server before the first deploy (Caddy gets the certificate for it).
STUDIO_DOMAIN=
# Email for the Let's Encrypt account (expiry notices). Read from the PRODUCTION file only.
ACME_EMAIL=

# ---- Secrets generated on the server (openssl rand -hex 32) ------------------------------------------
# Letters and digits only (it goes into DATABASE_URL). A different one per environment.
POSTGRES_PASSWORD=
# Bearer token for /api/metrics and the worker's :9464/metrics (at least 32 characters).
METRICS_TOKEN=
# Token PostMind Core sends on /api/studio/internal/** (at least 32 characters). Give it to Core
# (core mode); in standalone mode generate it anyway, nothing outside the server uses it.
STUDIO_INTERNAL_SERVICE_TOKEN=

# ---- Standalone product (Phase 18, plans/phase-18.md §6) ---------------------------------------------
# Sign-in: at least 32 random characters (openssl rand -hex 32). runbooks/auth.md has rotation.
BETTER_AUTH_SECRET=
# Stripe (runbooks/billing-stripe.md): secret key and the webhook endpoint's signing secret for
# https://STUDIO_DOMAIN/api/billing/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend (runbooks/email-resend.md): API key, webhook secret for
# https://STUDIO_DOMAIN/api/email/resend/webhook, and the sender on the verified domain, e.g.
# 'PostMind Studio <no-reply@mail.example.com>'.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STUDIO_EMAIL_FROM=
# Signs one-click unsubscribe links: at least 32 random characters.
STUDIO_UNSUBSCRIBE_SECRET=

# ---- KMS (envelope encryption) — AWS, from DevOps ---------------------------------------------------
AWS_REGION=
KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Object storage: Cloudflare R2, EU jurisdiction (runbooks/r2-setup.md) ----------------------------
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_JURISDICTION=eu
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Staging buckets are studio1eu / eustudio2 / eustudio3 / eustudio4 (render.yaml); production has its own.
S3_BUCKET_ASSETS=
S3_BUCKET_RENDERS=
S3_BUCKET_THUMBNAILS=
S3_BUCKET_LIBRARY=
# The backup bucket (r2-setup.md step 7): object copies under assets/ renders/ thumbnails/ and the
# Postgres backups under postgres/<STUDIO_ENV>/. Not a secret; its token is in the backup env file.
S3_BACKUP_BUCKET=

# ---- Pricing ------------------------------------------------------------------------------------------
STUDIO_USD_TO_GBP_RATE=0.75

# ---- Worker sizing for ONE shared vCPU / 2 GB (Hetzner CPX12). Raise with the server. -----------------
# FFmpeg/ffprobe children at once in the worker (src/lib/studio/pipeline/process-limit.ts).
STUDIO_FFMPEG_MAX_CONCURRENT=1
WORKER_CONCURRENCY_ORCHESTRATION=2
WORKER_CONCURRENCY_ASSETS=3
WORKER_CONCURRENCY_PUBLISH=2
WORKER_CONCURRENCY_SCHEDULED=1
WORKER_CONCURRENCY_ANALYTICS=1
# Email sends are small HTTP calls (Resend): 2 at once is plenty on 2 GB.
WORKER_CONCURRENCY_EMAIL=2
# Each library job buffers up to 200 MB: keep 1 on 2 GB (the 50k corpus run needs a bigger server).
STUDIO_LIBRARY_CONCURRENCY=1

# ---- Providers and platforms (runbooks/render-deploy.md step 4 table: same keys, same sources) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
SHOTSTACK_API_KEY=
# stage on staging; v1 on production.
SHOTSTACK_ENVIRONMENT=stage
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_REGION=eu
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =================================================================================================
# OPTIONAL — defaults in brackets
# =================================================================================================

# ---- Mode and optional product settings (Phase 18) ---------------------------------------------------
# [standalone] core = the pre-Phase-18 Core-integrated mode: the PostMind Core block below becomes
# REQUIRED and the standalone block above is not needed (deploy.sh checks the right set).
STUDIO_MODE=
# [empty] Google sign-in (a separate OAuth client from YouTube's; redirect
# https://STUDIO_DOMAIN/api/auth/callback/google). Hidden while unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [true] false = invite-only.
STUDIO_SIGNUPS_ENABLED=
# [empty] Leave empty: Caddy passes the client address in X-Real-IP. Only for a different proxy
# in front of web (its addresses, comma-separated; X-Forwarded-For is then walked past them).
STUDIO_AUTH_TRUSTED_PROXIES=
# [false / false] Superadmin impersonation (runbooks/auth.md).
STUDIO_IMPERSONATION_ENABLED=
STUDIO_IMPERSONATION_WRITE=
# [empty] Facebook Login for Business configuration id (runbooks/meta-connect.md).
META_LOGIN_CONFIG_ID=
# [${APP_URL}/api/studio/platform-connections/oauth-callback] Meta OAuth redirect, only if it differs.
META_REDIRECT_URI=
# [empty] Customer Portal configuration (scripts/billing/portal-config.ts).
STRIPE_PORTAL_CONFIGURATION_ID=
# [empty] Contact addresses and the legal entity shown on /pricing and the legal pages.
STUDIO_EMAIL_REPLY_TO=
STUDIO_SALES_EMAIL=
STUDIO_SUPPORT_EMAIL=
STUDIO_LEGAL_ENTITY_NAME=
# [https://STUDIO_DOMAIN/fonts] Where Shotstack and the worker fetch render fonts (<Family>.ttf).
# Leave empty: Studio serves its own from /fonts (public/fonts/SOURCES.md). Set (https) only for a
# CDN or a host that also has extra brand families.
STUDIO_FONTS_BASE_URL=

# ---- PostMind Core (core mode only; from the Core team) -----------------------------------------------
POSTMIND_CORE_URL=
POSTMIND_JWKS_URL=
POSTMIND_JWT_ISSUER=postmind-core
POSTMIND_JWT_AUDIENCE=postmind-studio
POSTMIND_AUDIT_URL=
POSTMIND_SERVICE_TOKEN=
# PostMind staff organisation ids, comma-separated (admin endpoints, core mode).
STUDIO_PLATFORM_ORG_IDS=

# ---- Deployment ----------------------------------------------------------------------------------------
# [ghcr.io/infoworksdomain-blip/postmind-studio] The image the deploy pulls (tag = git SHA).
STUDIO_IMAGE=
# [all seven queues] Space-separated queue list for the worker (split later onto a second service).
STUDIO_WORKER_QUEUES=
# [empty = internal API closed at the edge] Core's egress addresses, space-separated CIDRs, e.g.
# 203.0.113.10/32. Only these reach /api/studio/internal/** through Caddy.
STUDIO_INTERNAL_ALLOWED_CIDRS=
# [127.0.0.1/32] Only when Cloudflare PROXIES the domain: Cloudflare's ranges, space-separated
# (https://www.cloudflare.com/ips/). Read from the PRODUCTION file only.
CADDY_TRUSTED_PROXIES=
# [on] Postgres WAL archiving + base backups to R2 (needs the backup env file). off = no PITR.
PG_BACKUPS=on
# [22] Days of pgBackRest time-based retention. With weekly full backups the oldest backup data is
# at most retention + 8 days old, so 22 keeps everything within 30 days (GDPR, backup-recovery.md).
# deploy.sh refuses more than 22.
PG_BACKUP_RETENTION_DAYS=22
# [off] Prometheus + Alertmanager + blackbox (profile monitoring). Needs about 400 MB more than a
# 2 GB server has: switch on from 4 GB. Needs the two alert secret files (vps-deploy.md step 10).
STUDIO_MONITORING=off
# [9090 / 9093] Host ports on 127.0.0.1 (staging must use others, e.g. 9190 / 9193).
PROMETHEUS_HOST_PORT=
ALERTMANAGER_HOST_PORT=
# [15d]
PROMETHEUS_RETENTION=
# [empty] Where scripts/vps/backup.sh and healthcheck.sh post failures when Alertmanager is off: a
# Slack incoming webhook URL (they send {"text": "..."}). Host scripts only; the app ignores it.
OPS_ALERT_WEBHOOK_URL=
# [off] The browserless headless-render service (BACKLOG 14.4). Does not fit on 2 GB.
HEADLESS_RENDER=off
STUDIO_HEADLESS_RENDER_URL=
STUDIO_HEADLESS_RENDER_TOKEN=

# ---- Memory and CPU (defaults fit production on 1 vCPU / 2 GB; see runbooks/vps-deploy.md) -------------
# Container limits [postgres 384m, redis 128m, web 448m, worker 704m] and CPUs [1 each]. A CPU
# limit above the server's vCPU count stops the container from starting.
POSTGRES_MEM_LIMIT=
POSTGRES_CPUS=
REDIS_MEM_LIMIT=
WEB_MEM_LIMIT=
WEB_CPUS=
WORKER_MEM_LIMIT=
WORKER_CPUS=
# V8 heap caps in MB, below the container limits [web 288, worker 384].
WEB_NODE_HEAP_MB=
WORKER_NODE_HEAP_MB=
# Postgres [96MB, 512MB, 4MB, 64MB, 40]. On 4 GB: 256MB / 1536MB / 8MB / 128MB / 60.
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_CONNECTIONS=
# Prisma pools [web 5, worker 10]; their sum plus about 10 must stay under PG_MAX_CONNECTIONS.
WEB_DB_CONNECTION_LIMIT=
WORKER_DB_CONNECTION_LIMIT=
# [64mb] Valkey maxmemory (noeviction: a full Redis fails writes instead of dropping jobs).
REDIS_MAXMEMORY=

# ---- App settings (every other key in the repo's .env.example works here too) -----------------------
SENTRY_DSN=
LOG_LEVEL=info
BULLMQ_QUEUE_PREFIX=studio
RUNWAY_API_KEY=
LUMA_API_KEY=
# Google Veo 3.1 (third AI clip provider, after Seedance and Kling): a Gemini API key from https://aistudio.google.com/apikey
# on a project with billing enabled. [veo-3.1-fast-generate-preview] VEO_MODEL;
# VEO_PERSON_GENERATION: leave empty. Text-to-video then sends none (the API refuses allow_adult there);
# image-to-video always sends allow_adult. Set allow_all only for a server outside the EU/UK/CH/MENA.
GOOGLE_GEMINI_API_KEY=
VEO_MODEL=
VEO_PERSON_GENERATION=
# BytePlus ModelArk Seedance (first AI clip provider; then Kling, Veo, Runway, Luma): an API key from
# console.byteplus.com → ModelArk → API keys (ap-southeast-1), Seedance models activated, prepaid
# balance. [dreamina-seedance-2-0-mini-260615] SEEDANCE_MODEL (STANDARD);
# [dreamina-seedance-2-5-260628] SEEDANCE_LONG_MODEL (PLUS/ENTERPRISE and shots over 15 s);
# [https://ark.ap-southeast.bytepluses.com/api/v3] BYTEPLUS_ARK_BASE_URL.
BYTEPLUS_API_KEY=
SEEDANCE_MODEL=
SEEDANCE_LONG_MODEL=
BYTEPLUS_ARK_BASE_URL=
# Kling 3.0 (second AI clip provider, after Seedance): an API key from https://kling.ai/dev → Console → API Key, on
# an account with a video resource package. [kling-3.0] KLING_MODEL; [720p] KLING_RESOLUTION
# (or 1080p); [https://api-singapore.klingai.com] KLING_BASE_URL. Older accounts may instead set
# BOTH KLING_ACCESS_KEY and KLING_SECRET_KEY (legacy pair, signed into a JWT); the API key wins.
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=
KLING_RESOLUTION=
KLING_BASE_URL=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
STORYBLOCKS_API_PUBLIC_KEY=
STORYBLOCKS_API_PRIVATE_KEY=
PEXELS_API_KEY=
# [empty] Free stock images (runbooks/go-live.md 11.5): the key from https://pixabay.com/api/docs/
# (log in first). Without any stock key, scans add no stock images.
PIXABAY_API_KEY=
# [empty] Unsplash Access Key, after Unsplash approves the app for production (go-live.md 11.5).
# The stock fallback after Pixabay; works alone or together with PIXABAY_API_KEY.
UNSPLASH_ACCESS_KEY=
STUDIO_NOTIFY_WEBHOOK_URL=
STUDIO_NOTIFY_WEBHOOK_SECRET=

# =================================================================================================
# STAGING on the same server (staging.env): copy this file and change
#   STUDIO_ENV=staging, STUDIO_DOMAIN=studio-staging.…, a NEW POSTGRES_PASSWORD / METRICS_TOKEN /
#   STUDIO_INTERNAL_SERVICE_TOKEN, the staging buckets, SHOTSTACK_ENVIRONMENT=stage,
#   PROMETHEUS_HOST_PORT=9190, ALERTMANAGER_HOST_PORT=9193, and on a 2 GB server the smaller sizes:
#   POSTGRES_MEM_LIMIT=256m PG_SHARED_BUFFERS=48MB PG_MAX_CONNECTIONS=30 WEB_MEM_LIMIT=384m
#   WEB_NODE_HEAP_MB=240 WORKER_MEM_LIMIT=512m WORKER_NODE_HEAP_MB=288 REDIS_MEM_LIMIT=96m
#   REDIS_MAXMEMORY=48mb
# Production + staging together do NOT fit in 2 GB without heavy swapping: run staging only while
# testing, or give the server 4 GB RAM / 2 vCPU (runbooks/vps-deploy.md "Staging").
# =================================================================================================
