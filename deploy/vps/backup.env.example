# PostMind Studio — backup credentials for the single-server deployment. Copy to the SERVER as
#   /etc/postmind-studio/<env>.backup.env   (chmod 600, deploy user)
# and never commit the filled-in copy. Only Postgres (WAL archiving, pgBackRest) and the
# backup-storage job receive these values; the web and worker containers never do, so an app
# compromise cannot delete the backups (runbooks/backup-recovery.md). Single-quote the values.
#
# Needed when PG_BACKUPS=on (the default) and for the nightly object-storage backup copy.

# The backup job's R2 token (runbooks/r2-setup.md step 7): READ on the live buckets, READ & WRITE on
# S3_BACKUP_BUCKET. pgBackRest uses the same token for postgres/<env>/ in that bucket.
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=

# pgBackRest encrypts every backup and WAL file with this passphrase before upload (aes-256-cbc,
# client-side). Generate once with `openssl rand -hex 32` and ALSO keep it in the password manager:
# without it the backups cannot be restored. Never change it on an existing repository.
PG_BACKUP_CIPHER_PASS=
