{
  "name": "postmind-studio",
  "version": "0.1.0",
  "private": true,
  "description": "PostMind Studio — AI video generation and multi-platform publishing microservice for PostMind AI.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:validate": "dotenv -e .env.example -- prisma validate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset --force",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "gate2:anthropic": "dotenv -e .env.local -- tsx scripts/test-anthropic.ts",
    "gate2:runway": "dotenv -e .env.local -- tsx scripts/test-runway.ts",
    "gate2:elevenlabs": "dotenv -e .env.local -- tsx scripts/test-elevenlabs.ts",
    "gate2:shotstack": "dotenv -e .env.local -- tsx scripts/test-shotstack.ts",
    "gate2:router": "dotenv -e .env.local -- tsx scripts/test-router.ts",
    "gate3": "dotenv -e .env.local -- tsx scripts/run-test-project.ts",
    "worker": "dotenv -e .env.local -- tsx scripts/worker.ts",
    "db:local": "tsx scripts/dev/pglite-server.ts 55432",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-kms": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@sentry/core": "^10.75.0",
    "@sentry/nextjs": "^10.75.0",
    "@sentry/node": "^10.75.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.0.4",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "^3.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
