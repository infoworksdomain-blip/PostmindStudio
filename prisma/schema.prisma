// PostMind Studio — Prisma schema.
// Every Studio table lives in the `studio` Postgres schema of the shared PostMind cluster.
// Never add models to any other schema: PostMind Core's schema is off-limits (CLAUDE.md rule 1).
// multiSchema is GA since Prisma 6.13, so `schemas` needs no preview flag.
//
// Sources: v1.0 spec Section 7 (19 tables) + Addendum v1.1 Section A7 (14 tables, 3 changes).
// Models are transcribed from the spec. Annotations:
//   DERIVED   — the spec names the table but gives no model; fields inferred from its prose.
//   DEVIATION — intentional difference from the spec model, with the reason.
// Cross-schema references (organisationId, userId, businessId) are plain Strings, no SQL FK
// (spec 7.1 / 7.14).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["studio"]
  extensions = [vector]
}

// =============================================================================
// v1.0 — spec Section 7
// =============================================================================

// 7.3 + A7.2 (referenceVideoId, referenceMode, extended enums)
model VideoProject {
  id               String            @id @default(cuid())
  organisationId   String // ref PostMind Core
  businessId       String // ref PostMind Core
  createdByUserId  String // ref PostMind Core
  // 17.9: null = the user gave no name; the UI shows a translated "Untitled video" (never stored).
  name             String?
  description      String?
  state            VideoProjectState
  sourceType       VideoSourceType
  sourceRef        String? // e.g. postmind post id
  referenceVideoId String? // A7.2 — ref VideoLibraryItem
  referenceMode    ReferenceMode? // A7.2
  targetFormats    Json // [{ platform, aspectRatio, duration }]
  brandKitId       String? // ref BrandKit
  templateId       String? // ref Template
  costBudgetPence  Int? // hard cap for this project
  costActualPence  Int               @default(0)
  costCurrency     String            @default("GBP")
  reviewPolicy     ReviewPolicy      @default(REQUIRE_APPROVAL)
  publishPolicy    PublishPolicy     @default(MANUAL)
  scheduledStartAt DateTime?
  // 15.B7: per-project render options { fps?: 24|30|60, youtubeResolution?: '1080'|'4k', draft?: bool }
  renderOptions    Json?
  completedAt      DateTime?
  errorReason      String?
  metadata         Json?
  // 15.C5 (spec 3.1): BCP 47 language of the video (scripts, voice, captions).
  language         String            @default("en-GB")

  brief        VideoBrief?
  scripts      VideoScript[]
  renders      VideoRender[]
  publications VideoPublication[]
  approvals    ApprovalTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, state])
  @@index([businessId, createdAt])
  @@map("video_projects")
  @@schema("studio")
}

enum VideoProjectState {
  DRAFT
  QUEUED
  SCANNING // A7.2 — slideshow auto-populate
  PLANNING
  ASSETS_QUEUED
  ASSETS_GENERATING
  RENDERING
  QUALITY_CHECKING
  QUALITY_FAILED
  READY_FOR_REVIEW
  APPROVED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  REJECTED
  FAILED
  ARCHIVED

  @@schema("studio")
}

enum VideoSourceType {
  BRIEF
  POSTMIND_CONTENT
  TEMPLATE
  UPLOAD
  LIBRARY_REFERENCE // A7.2
  SLIDESHOW // A7.2

  @@schema("studio")
}

enum ReferenceMode {
  TEMPLATE
  INSPIRE

  @@schema("studio")
}

enum ReviewPolicy {
  AUTO_APPROVE
  REQUIRE_APPROVAL
  REQUIRE_APPROVAL_FROM_ROLE

  @@schema("studio")
}

enum PublishPolicy {
  MANUAL
  SCHEDULED
  AUTO_ON_APPROVAL

  @@schema("studio")
}

// 7.4
model VideoBrief {
  id             String       @id @default(cuid())
  projectId      String       @unique
  project        VideoProject @relation(fields: [projectId], references: [id])
  rawInput       String // user's original words
  hook           String
  keyMessage     String
  targetAudience String
  tone           String
  callToAction   String?
  keywords       Json // [String]
  ideationModel  String // e.g. 'anthropic:claude-sonnet-4-5'
  createdAt      DateTime     @default(now())

  @@map("video_briefs")
  @@schema("studio")
}

// 7.5
model VideoScript {
  id                String       @id @default(cuid())
  projectId         String
  project           VideoProject @relation(fields: [projectId], references: [id])
  targetPlatform    String // 'tiktok' | 'instagram_reel' | ...
  targetAspectRatio String // '9:16' | '16:9' | '1:1' | '4:5'
  targetDurationSec Int
  language          String       @default("en-GB")
  fullText          String // whole voiceover as one blob
  shots             VideoShot[]
  scriptModel       String
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([projectId])
  @@map("video_scripts")
  @@schema("studio")
}

// 7.5 + A7.2 (shot → overlays is 1-to-many via text_overlays.shotId)
model VideoShot {
  id               String          @id @default(cuid())
  scriptId         String
  script           VideoScript     @relation(fields: [scriptId], references: [id])
  sortOrder        Int
  durationSec      Float
  visualTreatment  VisualTreatment
  sceneDescription String // prompt for generation
  cameraDirection  String?
  voiceoverText    String?
  onScreenText     String?
  transitionOut    String? // 'cut' | 'fade' | 'whoosh' | ...
  // BACKLOG 13.27: Layer 2 sound-effect cue ("whoosh", "cash register ding"), played at the
  // shot's start (the cut into it). Null = no SFX. Resolved to an AUDIO_SFX asset in compose.
  sfxCue           String?
  providerRouting  Json? // routing decision snapshot
  assetId          String? // resolved asset id once generated
  voiceAssetId     String?
  state            ShotState
  errorReason      String?
  overlays         TextOverlay[]

  @@index([scriptId, sortOrder])
  @@map("video_shots")
  @@schema("studio")
}

enum VisualTreatment {
  AI_CLIP
  AI_AVATAR
  STOCK_FOOTAGE
  IMAGE_STILL
  MOTION_GRAPHICS
  USER_UPLOAD
  TEXT_CARD
  TRANSITION

  @@schema("studio")
}

enum ShotState {
  PLANNED
  QUEUED
  GENERATING
  READY
  FAILED
  SKIPPED

  @@schema("studio")
}

// 7.6
model VideoAsset {
  id             String    @id @default(cuid())
  organisationId String
  projectId      String
  shotId         String? // null for music/sfx not tied to a shot
  kind           AssetKind
  source         String // e.g. 'runway:gen-4-turbo', 'elevenlabs:v2'
  s3Bucket       String
  s3Key          String
  publicUrl      String? // signed CDN URL
  durationSec    Float?
  widthPx        Int?
  heightPx       Int?
  fileSizeBytes  BigInt?
  fingerprint    String? // perceptual hash for reuse
  providerJobId  String? // ref ProviderJob
  costPence      Int       @default(0)
  metadata       Json? // provider-specific
  createdAt      DateTime  @default(now())

  @@index([organisationId, fingerprint])
  @@index([projectId])
  @@index([shotId])
  @@map("video_assets")
  @@schema("studio")
}

enum AssetKind {
  VIDEO_CLIP
  IMAGE
  AUDIO_VOICE
  AUDIO_MUSIC
  AUDIO_SFX

  @@schema("studio")
}

// 7.7
model VideoRender {
  id                String             @id @default(cuid())
  projectId         String
  project           VideoProject       @relation(fields: [projectId], references: [id])
  scriptId          String // which script produced this render
  targetPlatform    String
  aspectRatio       String
  resolution        String // '1920x1080'
  durationSec       Float
  fps               Int
  bitrateKbps       Int
  s3Bucket          String
  s3Key             String
  publicUrl         String?
  thumbnailS3Key    String?
  captionsSrtS3Key  String?
  composerJobId     String? // shotstack render id
  qualityCheckState QualityCheckState
  qualityIssues     Json? // [{code, severity, detail}]
  costPence         Int                @default(0)
  // 15.B2/B6: what Layer 6 put on the timeline (edlHash, brand elements, shot/voice/caption
  // spans) — read by the quality gate's sync and brand checks and by the composition cache.
  composition       Json?
  createdAt         DateTime           @default(now())
  publications      VideoPublication[]

  @@index([projectId])
  @@map("video_renders")
  @@schema("studio")
}

enum QualityCheckState {
  PENDING
  PASSED
  FAILED
  FORCE_APPROVED

  @@schema("studio")
}

// BACKLOG 13.25 — Hive async moderation for renders longer than Hive's 90 s sync limit. One row
// per (render, run). Hive documents no callback signature, so each task carries an unguessable
// per-task callback token (only its SHA-256 is stored) in the callback URL. `result` holds the
// callback body (Hive's task object) until the quality gate settles it.
model ContentSafetyTask {
  id                String                 @id @default(cuid())
  organisationId    String
  projectId         String
  runId             String
  renderId          String
  planTier          String // job data to resume run-quality-gate on callback
  providerId        String // 'hive'
  providerJobRowId  String? // studio.provider_jobs.id (cost + breaker tracking)
  providerTaskId    String? // Hive task id
  callbackTokenHash String                 @unique
  state             ContentSafetyTaskState @default(SUBMITTED)
  result            Json?
  errorReason       String?
  submittedAt       DateTime               @default(now())
  callbackAt        DateTime?
  expiresAt         DateTime
  updatedAt         DateTime               @updatedAt

  @@unique([renderId, runId])
  @@index([providerTaskId])
  @@index([projectId, runId])
  @@map("content_safety_tasks")
  @@schema("studio")
}

enum ContentSafetyTaskState {
  SUBMITTED
  CALLBACK_RECEIVED
  SETTLED
  FAILED
  EXPIRED

  @@schema("studio")
}

// 7.8
model VideoPublication {
  id                String           @id @default(cuid())
  organisationId    String
  projectId         String
  project           VideoProject     @relation(fields: [projectId], references: [id])
  renderId          String
  render            VideoRender      @relation(fields: [renderId], references: [id])
  platform          String // 'tiktok' | 'instagram_reel' | ...
  platformAccountId String // channel identifier
  scheduledFor      DateTime?
  publishedAt       DateTime?
  platformPostId    String? // the platform's ID for the post
  platformUrl       String?
  state             PublicationState
  caption           String?
  hashtags          String[]
  errorReason       String?
  errorCode         String?
  retryCount        Int              @default(0)
  metadata          Json? // per-platform extras
  analytics         VideoAnalytic[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([platform, platformPostId])
  @@index([organisationId, publishedAt])
  @@index([state, scheduledFor])
  @@map("video_publications")
  @@schema("studio")
}

enum PublicationState {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  TAKEN_DOWN

  @@schema("studio")
}

// 7.9
model VideoAnalytic {
  id              String           @id @default(cuid())
  publicationId   String
  publication     VideoPublication @relation(fields: [publicationId], references: [id])
  bucketAt        DateTime // aligned to hour/day
  bucketSize      String // 'hour' | 'day'
  views           Int              @default(0)
  uniqueViewers   Int?
  watchTimeSec    Int              @default(0)
  avgWatchTimePct Float? // 0-1
  likes           Int              @default(0)
  comments        Int              @default(0)
  shares          Int              @default(0)
  saves           Int              @default(0)
  clicks          Int              @default(0)
  retentionCurve  Json? // [{sec, retention}]
  demographics    Json?

  @@unique([publicationId, bucketAt, bucketSize])
  @@index([publicationId, bucketAt])
  @@map("video_analytics")
  @@schema("studio")
}

// 7.10
model ProviderJob {
  id             String           @id @default(cuid())
  organisationId String
  projectId      String?
  provider       String // 'runway', 'elevenlabs', ...
  providerJobId  String? // provider's own id
  operation      String // 'text_to_video', 'tts', ...
  requestBody    Json // truncated for size
  responseBody   Json?
  state          ProviderJobState
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  durationMs     Int?
  costPence      Int              @default(0)
  errorClass     String?
  errorMessage   String?
  retryCount     Int              @default(0)

  @@index([organisationId, provider, startedAt])
  @@index([provider, state])
  @@index([startedAt]) // 13.16 admin provider health (last hour, all providers)
  @@map("provider_jobs")
  @@schema("studio")
}

enum ProviderJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED

  @@schema("studio")
}

// DERIVED — spec 7.2 "Rolled-up cost per (org, provider, day)"; written on every provider
// call (spec 6.7 "Cost meter wired to studio.provider_usage"), read by cost caps (12.5).
model ProviderUsage {
  id             String   @id @default(cuid())
  organisationId String
  provider       String
  day            DateTime @db.Date
  jobCount       Int      @default(0)
  succeededCount Int      @default(0)
  failedCount    Int      @default(0)
  costPence      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, provider, day])
  @@index([provider, day])
  @@index([day]) // Phase 12: global daily cap (spec 12.5) sums one day across all orgs
  @@index([organisationId, day]) // monthly org cap: one org's month-to-date sum
  @@map("provider_usage")
  @@schema("studio")
}

// 7.11 + A7.2 (businessProfileId)
model BrandKit {
  id                String    @id @default(cuid())
  organisationId    String
  businessId        String // ref PostMind Core
  businessProfileId String? // A7.2 — ref BusinessProfile
  name              String
  isDefault         Boolean   @default(false)
  logoAssetId       String?
  watermarkAssetId  String?
  colourPalette     Json // hex colour array
  fontPrimary       String?
  fontSecondary     String?
  toneKeywords      String[]
  audienceProfile   String?
  ctaTemplates      Json // [{ label, template }]
  introCardAssetId  String?
  outroCardAssetId  String?
  voiceProfileId    String?
  restrictedTopics  String[] // never mention
  // 15.B1: spec 8.5 DELETE is a soft delete.
  deletedAt         DateTime?
  // Operator decision P6 (2026-09-28): optional on-video "AI-generated" corner label, default off
  // (platform AI labels stay always on).
  aiDisclosureLabel Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organisationId, businessId])
  @@map("brand_kits")
  @@schema("studio")
}

// 7.11
model VoiceProfile {
  id                           String    @id @default(cuid())
  organisationId               String
  businessId                   String?
  name                         String
  provider                     String // 'elevenlabs'
  providerVoiceId              String
  cloneSourceAssetId           String?
  languagesSupported           String[]
  isDefault                    Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  // Phase 13.13 (spec 10.2 / 13.4): cloning needs recorded consent. READY | REQUIRES_VERIFICATION
  // (ElevenLabs asked for voice verification) | PENDING_REVIEW (15.C7 consent check not passed)
  // | DELETED (revoked at the provider; the row stays as the consent audit record).
  state                        String    @default("READY")
  speakerName                  String?
  consentStatement             String?
  // 17.8: the interface locale the statement was shown in and its catalogue key (null when the
  // user edited the statement, or on older rows). The recording stays the consent evidence.
  consentStatementLocale       String?
  consentStatementKey          String?
  consentGivenByUserId         String?
  consentGivenAt               DateTime?
  consentS3Bucket              String?
  consentS3Key                 String?
  // 15.C7 (spec 10.2): automatic check that the consent recording says the statement.
  // passed | mismatch | unavailable; anything but passed keeps state PENDING_REVIEW.
  consentCheck                 String?
  consentTranscript            String?
  consentCheckedAt             DateTime?
  // ElevenLabs asked for voice verification at cloning (state after a passed check).
  providerVerificationRequired Boolean   @default(false)
  sampleCount                  Int       @default(0)
  sampleSeconds                Float?
  deletedAt                    DateTime?
  deletedByUserId              String?
  updatedAt                    DateTime  @default(now()) @updatedAt

  @@index([organisationId, businessId])
  @@map("voice_profiles")
  @@schema("studio")
}

// DERIVED — spec 14.5 onboarding first-run (Phase 13.14): one row per (organisation, user).
// step = where the /welcome wizard resumes; completed = the steps done so far.
model OnboardingState {
  id                  String    @id @default(cuid())
  organisationId      String
  userId              String
  step                String    @default("connect") // connect | brand_kit | first_video | celebrate | done
  completed           String[]
  firstVideoProjectId String?
  dismissedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([organisationId, userId])
  @@map("onboarding_states")
  @@schema("studio")
}

// DERIVED — spec 7.2 "Feedback-informed generation preferences, 1–5 per business" and 10.3/10.4.
// One row per signal category (shot pace, treatment mix, provider preference, script structure,
// posting time — the five 10.3 lists), which gives the "1–5 per business" row count.
// `reason` backs the 10.4 transparency requirement: users can inspect and delete each signal.
model StyleMemory {
  id             String          @id @default(cuid())
  organisationId String
  businessId     String
  signalType     StyleSignalType
  value          Json // e.g. { preferredShotCount: 3, hookWithinSec: 1.2 }
  weight         Float           @default(0)
  evidenceCount  Int             @default(0)
  reason         String // human-readable explanation shown at /brand-memory
  lastEvidenceAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  // 15.E6 (spec 10.4 "view and edit"): pinned rows are never overwritten or removed by the
  // nightly build; disabled rows are kept but never injected into Layer 1–2 prompts.
  pinned         Boolean         @default(false)
  disabled       Boolean         @default(false)
  editedByUserAt DateTime?

  @@unique([organisationId, businessId, signalType])
  @@map("style_memories")
  @@schema("studio")
}

enum StyleSignalType {
  SHOT_PACE
  TREATMENT_MIX
  PROVIDER_PREFERENCE
  SCRIPT_STRUCTURE
  POSTING_TIME

  @@schema("studio")
}

// 7.12
model Template {
  id              String   @id @default(cuid())
  organisationId  String? // null = built-in
  name            String
  category        String
  targetFormats   Json
  scriptTemplate  String // Handlebars-style with {{vars}}
  shotBlueprint   Json
  brandKitHints   Json?
  // DERIVED (Phase 12 automation): spec 3 "auto-publish (on approval per template)" names the
  // behaviour but no field. { publishPolicy, reviewPolicy?, targets: [{ platform, connectionId? |
  // platformAccountId?, caption?, hashtags?, scheduleOffsetMinutes? }] } — applied to projects
  // created from the template (src/lib/studio/automation/auto-publish.ts validates it).
  publishDefaults Json?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([organisationId, category])
  @@map("templates")
  @@schema("studio")
}

// 7.12
model ScheduledPublication {
  id            String        @id @default(cuid())
  publicationId String        @unique // pre-created publication row
  scheduledFor  DateTime
  state         ScheduleState
  jobId         String? // bullmq job id

  @@index([scheduledFor, state])
  @@map("scheduled_publications")
  @@schema("studio")
}

enum ScheduleState {
  PENDING
  FIRED
  CANCELLED

  @@schema("studio")
}

// 7.12
model PlatformConnection {
  id                    String    @id @default(cuid())
  organisationId        String
  businessId            String? // NULL: org-wide (Meta channels registered by PostMind Core)
  platform              String // 'tiktok', 'youtube', 'x', 'linkedin', 'instagram', 'facebook'
  platformAccountId     String
  platformAccountName   String
  encryptedAccessToken  String // envelope-encrypted
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scopes                String[]
  state                 String // 'active' | 'needs_reconnect' | 'revoked'
  connectedByUserId     String
  connectedAt           DateTime  @default(now())
  /// BACKLOG 17.3: the daily account-status check (services/account-status.ts) — when it last ran
  /// for this connection and what it found: ok | needs_reconnect | unreachable (unreachable never
  /// changes `state`).
  statusCheckedAt       DateTime?
  statusCheckOutcome    String?
  /// Phase 18 §2.10: who obtained the tokens — 'core' (pushed by PostMind Core) or 'studio'
  /// (Studio's own OAuth). NULL on rows written before Phase 18 (all of them came from Core).
  connectedVia          String?
  /// Phase 18 §2.10: the Meta app-scoped user id whose Facebook Login for Business connected this
  /// Page / IG account (Studio's own OAuth only; NULL otherwise). The deauthorise and
  /// data-deletion callbacks name that id, so this is how they find the rows to revoke.
  metaUserId            String?

  @@unique([organisationId, platform, platformAccountId])
  @@index([state, statusCheckedAt])
  @@index([metaUserId])
  @@map("platform_connections")
  @@schema("studio")
}

// 7.13
model ApprovalWorkflow {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  steps          Json // ordered [{ role, minApprovers }]
  appliesTo      Json // {platforms, businessIds, tags}
  createdAt      DateTime @default(now())

  @@map("approval_workflows")
  @@schema("studio")
}

// 7.13
model ApprovalTask {
  id               String            @id @default(cuid())
  projectId        String
  project          VideoProject      @relation(fields: [projectId], references: [id])
  workflowId       String?
  stepIndex        Int
  requiredRole     String
  state            ApprovalTaskState
  resolvedByUserId String?
  note             String?
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?

  @@index([projectId, stepIndex])
  @@map("approval_tasks")
  @@schema("studio")
}

enum ApprovalTaskState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("studio")
}

// Kill switch + feature flags. Model copied from the Engagement handover 6.4.1.
// Keys are listed in src/lib/studio/system-flags.ts.
model SystemFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_flags")
  @@schema("studio")
}

// =============================================================================
// v1.1 — Addendum Section A7
// =============================================================================

// A7.3 — Feature A
model VideoLibraryItem {
  id                 String                 @id @default(cuid())
  title              String
  description        String?
  categoryId         String
  category           VideoLibraryCategory   @relation(fields: [categoryId], references: [id])
  tags               String[]
  sourceUrl          String?
  sourcePlatform     String? // 'tiktok','instagram','user_upload'
  s3Bucket           String
  s3Key              String
  thumbnailS3Key     String
  durationSec        Float
  aspectRatio        String
  ingestedAt         DateTime               @default(now())
  analysis           VideoLibraryAnalysis?
  embedding          VideoLibraryEmbedding?
  license            VideoLibraryLicense?
  retiredAt          DateTime? // hidden from search
  // 15.D7 / A3.8: staff review of the automatic categorisation (null = not reviewed yet).
  categoryReview     LibraryCategoryReview?
  categoryReviewedAt DateTime?
  /**
   * 15.D7: last re-analysis (POST /admin/library/reanalyse); null = only the original ingest.
   */
  reanalysedAt       DateTime?

  @@index([categoryId, retiredAt])
  @@index([tags], type: Gin)
  @@map("video_library")
  @@schema("studio")
}

// DERIVED — A3.2 "Hierarchical category tree … ~200 rows across 3-4 levels", A3.4 seed taxonomy.
model VideoLibraryCategory {
  id        String                 @id @default(cuid())
  slug      String                 @unique // e.g. 'business/e-commerce/fashion'
  name      String
  parentId  String?
  parent    VideoLibraryCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  VideoLibraryCategory[] @relation("CategoryTree")
  depth     Int // 0 = top level
  sortOrder Int                    @default(0)
  items     VideoLibraryItem[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([parentId, sortOrder])
  @@map("video_library_categories")
  @@schema("studio")
}

// DERIVED — A3.2 "Free-form tags … ~5,000 unique tags". Items keep their tags in
// VideoLibraryItem.tags (as A7.3 specifies); this is the tag dictionary used for
// autocomplete and admin curation.
model VideoLibraryTag {
  id         String   @id @default(cuid())
  name       String   @unique
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("video_library_tags")
  @@schema("studio")
}

// A7.4
model VideoLibraryAnalysis {
  id               String           @id @default(cuid())
  libraryItemId    String           @unique
  libraryItem      VideoLibraryItem @relation(fields: [libraryItemId], references: [id])
  shotCount        Int
