// PostMind Studio — Prisma schema.
// Every Studio table lives in the `studio` Postgres schema of the shared PostMind cluster.
// Never add models to any other schema: PostMind Core's schema is off-limits (CLAUDE.md rule 1).
// multiSchema is GA since Prisma 6.13, so `schemas` needs no preview flag.
//
// Sources: v1.0 spec Section 7 (19 tables) + Addendum v1.1 Section A7 (14 tables, 3 changes).
// Models are transcribed from the spec. Annotations:
//   DERIVED   — the spec names the table but gives no model; fields inferred from its prose.
//   DEVIATION — intentional difference from the spec model, with the reason.
// Cross-schema references (organisationId, userId, businessId) are plain Strings, no SQL FK
// (spec 7.1 / 7.14).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["studio"]
  extensions = [vector]
}

// =============================================================================
// v1.0 — spec Section 7
// =============================================================================

// 7.3 + A7.2 (referenceVideoId, referenceMode, extended enums)
model VideoProject {
  id               String            @id @default(cuid())
  organisationId   String // ref PostMind Core
  businessId       String // ref PostMind Core
  createdByUserId  String // ref PostMind Core
  name             String
  description      String?
  state            VideoProjectState
  sourceType       VideoSourceType
  sourceRef        String? // e.g. postmind post id
  referenceVideoId String? // A7.2 — ref VideoLibraryItem
  referenceMode    ReferenceMode? // A7.2
  targetFormats    Json // [{ platform, aspectRatio, duration }]
  brandKitId       String? // ref BrandKit
  templateId       String? // ref Template
  costBudgetPence  Int? // hard cap for this project
  costActualPence  Int               @default(0)
  costCurrency     String            @default("GBP")
  reviewPolicy     ReviewPolicy      @default(REQUIRE_APPROVAL)
  publishPolicy    PublishPolicy     @default(MANUAL)
  scheduledStartAt DateTime?
  completedAt      DateTime?
  errorReason      String?
  metadata         Json?

  brief        VideoBrief?
  scripts      VideoScript[]
  renders      VideoRender[]
  publications VideoPublication[]
  approvals    ApprovalTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, state])
  @@index([businessId, createdAt])
  @@map("video_projects")
  @@schema("studio")
}

enum VideoProjectState {
  DRAFT
  QUEUED
  SCANNING // A7.2 — slideshow auto-populate
  PLANNING
  ASSETS_QUEUED
  ASSETS_GENERATING
  RENDERING
  QUALITY_CHECKING
  QUALITY_FAILED
  READY_FOR_REVIEW
  APPROVED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  REJECTED
  FAILED
  ARCHIVED

  @@schema("studio")
}

enum VideoSourceType {
  BRIEF
  POSTMIND_CONTENT
  TEMPLATE
  UPLOAD
  LIBRARY_REFERENCE // A7.2
  SLIDESHOW // A7.2

  @@schema("studio")
}

enum ReferenceMode {
  TEMPLATE
  INSPIRE

  @@schema("studio")
}

enum ReviewPolicy {
  AUTO_APPROVE
  REQUIRE_APPROVAL
  REQUIRE_APPROVAL_FROM_ROLE

  @@schema("studio")
}

enum PublishPolicy {
  MANUAL
  SCHEDULED
  AUTO_ON_APPROVAL

  @@schema("studio")
}

// 7.4
model VideoBrief {
  id             String       @id @default(cuid())
  projectId      String       @unique
  project        VideoProject @relation(fields: [projectId], references: [id])
  rawInput       String // user's original words
  hook           String
  keyMessage     String
  targetAudience String
  tone           String
  callToAction   String?
  keywords       Json // [String]
  ideationModel  String // e.g. 'anthropic:claude-sonnet-4-5'
  createdAt      DateTime     @default(now())

  @@map("video_briefs")
  @@schema("studio")
}

// 7.5
model VideoScript {
  id                String       @id @default(cuid())
  projectId         String
  project           VideoProject @relation(fields: [projectId], references: [id])
  targetPlatform    String // 'tiktok' | 'instagram_reel' | ...
  targetAspectRatio String // '9:16' | '16:9' | '1:1' | '4:5'
  targetDurationSec Int
  language          String       @default("en-GB")
  fullText          String // whole voiceover as one blob
  shots             VideoShot[]
  scriptModel       String
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([projectId])
  @@map("video_scripts")
  @@schema("studio")
}

// 7.5 + A7.2 (shot → overlays is 1-to-many via text_overlays.shotId)
model VideoShot {
  id               String          @id @default(cuid())
  scriptId         String
  script           VideoScript     @relation(fields: [scriptId], references: [id])
  sortOrder        Int
  durationSec      Float
  visualTreatment  VisualTreatment
  sceneDescription String // prompt for generation
  cameraDirection  String?
  voiceoverText    String?
  onScreenText     String?
  transitionOut    String? // 'cut' | 'fade' | 'whoosh' | ...
  // BACKLOG 13.27: Layer 2 sound-effect cue ("whoosh", "cash register ding"), played at the
  // shot's start (the cut into it). Null = no SFX. Resolved to an AUDIO_SFX asset in compose.
  sfxCue           String?
  providerRouting  Json? // routing decision snapshot
  assetId          String? // resolved asset id once generated
  voiceAssetId     String?
  state            ShotState
  errorReason      String?
  overlays         TextOverlay[]

  @@index([scriptId, sortOrder])
  @@map("video_shots")
  @@schema("studio")
}

enum VisualTreatment {
  AI_CLIP
  AI_AVATAR
  STOCK_FOOTAGE
  IMAGE_STILL
  MOTION_GRAPHICS
  USER_UPLOAD
  TEXT_CARD
  TRANSITION

  @@schema("studio")
}

enum ShotState {
  PLANNED
  QUEUED
  GENERATING
  READY
  FAILED
  SKIPPED

  @@schema("studio")
}

// 7.6
model VideoAsset {
  id             String    @id @default(cuid())
  organisationId String
  projectId      String
  shotId         String? // null for music/sfx not tied to a shot
  kind           AssetKind
  source         String // e.g. 'runway:gen-4-turbo', 'elevenlabs:v2'
  s3Bucket       String
  s3Key          String
  publicUrl      String? // signed CDN URL
  durationSec    Float?
  widthPx        Int?
  heightPx       Int?
  fileSizeBytes  BigInt?
  fingerprint    String? // perceptual hash for reuse
  providerJobId  String? // ref ProviderJob
  costPence      Int       @default(0)
  metadata       Json? // provider-specific
  createdAt      DateTime  @default(now())

  @@index([organisationId, fingerprint])
  @@index([projectId])
  @@index([shotId])
  @@map("video_assets")
  @@schema("studio")
}

enum AssetKind {
  VIDEO_CLIP
  IMAGE
  AUDIO_VOICE
  AUDIO_MUSIC
  AUDIO_SFX

  @@schema("studio")
}

// 7.7
model VideoRender {
  id                String             @id @default(cuid())
  projectId         String
  project           VideoProject       @relation(fields: [projectId], references: [id])
  scriptId          String // which script produced this render
  targetPlatform    String
  aspectRatio       String
  resolution        String // '1920x1080'
  durationSec       Float
  fps               Int
  bitrateKbps       Int
  s3Bucket          String
  s3Key             String
  publicUrl         String?
  thumbnailS3Key    String?
  captionsSrtS3Key  String?
  composerJobId     String? // shotstack render id
  qualityCheckState QualityCheckState
  qualityIssues     Json? // [{code, severity, detail}]
  costPence         Int                @default(0)
  createdAt         DateTime           @default(now())
  publications      VideoPublication[]

  @@index([projectId])
  @@map("video_renders")
  @@schema("studio")
}

enum QualityCheckState {
  PENDING
  PASSED
  FAILED
  FORCE_APPROVED

  @@schema("studio")
}

// BACKLOG 13.25 — Hive async moderation for renders longer than Hive's 90 s sync limit. One row
// per (render, run). Hive documents no callback signature, so each task carries an unguessable
// per-task callback token (only its SHA-256 is stored) in the callback URL. `result` holds the
// callback body (Hive's task object) until the quality gate settles it.
model ContentSafetyTask {
  id                String                 @id @default(cuid())
  organisationId    String
  projectId         String
  runId             String
  renderId          String
  planTier          String // job data to resume run-quality-gate on callback
  providerId        String // 'hive'
  providerJobRowId  String? // studio.provider_jobs.id (cost + breaker tracking)
  providerTaskId    String? // Hive task id
  callbackTokenHash String                 @unique
  state             ContentSafetyTaskState @default(SUBMITTED)
  result            Json?
  errorReason       String?
  submittedAt       DateTime               @default(now())
  callbackAt        DateTime?
  expiresAt         DateTime
  updatedAt         DateTime               @updatedAt

  @@unique([renderId, runId])
  @@index([providerTaskId])
  @@index([projectId, runId])
  @@map("content_safety_tasks")
  @@schema("studio")
}

enum ContentSafetyTaskState {
  SUBMITTED
  CALLBACK_RECEIVED
  SETTLED
  FAILED
  EXPIRED

  @@schema("studio")
}

// 7.8
model VideoPublication {
  id                String           @id @default(cuid())
  organisationId    String
  projectId         String
  project           VideoProject     @relation(fields: [projectId], references: [id])
  renderId          String
  render            VideoRender      @relation(fields: [renderId], references: [id])
  platform          String // 'tiktok' | 'instagram_reel' | ...
  platformAccountId String // channel identifier
  scheduledFor      DateTime?
  publishedAt       DateTime?
  platformPostId    String? // the platform's ID for the post
  platformUrl       String?
  state             PublicationState
  caption           String?
  hashtags          String[]
  errorReason       String?
  errorCode         String?
  retryCount        Int              @default(0)
  metadata          Json? // per-platform extras
  analytics         VideoAnalytic[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([platform, platformPostId])
  @@index([organisationId, publishedAt])
  @@index([state, scheduledFor])
  @@map("video_publications")
  @@schema("studio")
}

enum PublicationState {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  TAKEN_DOWN

  @@schema("studio")
}

// 7.9
model VideoAnalytic {
  id              String           @id @default(cuid())
  publicationId   String
  publication     VideoPublication @relation(fields: [publicationId], references: [id])
  bucketAt        DateTime // aligned to hour/day
  bucketSize      String // 'hour' | 'day'
  views           Int              @default(0)
  uniqueViewers   Int?
  watchTimeSec    Int              @default(0)
  avgWatchTimePct Float? // 0-1
  likes           Int              @default(0)
  comments        Int              @default(0)
  shares          Int              @default(0)
  saves           Int              @default(0)
  clicks          Int              @default(0)
  retentionCurve  Json? // [{sec, retention}]
  demographics    Json?

  @@unique([publicationId, bucketAt, bucketSize])
  @@index([publicationId, bucketAt])
  @@map("video_analytics")
  @@schema("studio")
}

// 7.10
model ProviderJob {
  id             String           @id @default(cuid())
  organisationId String
  projectId      String?
  provider       String // 'runway', 'elevenlabs', ...
  providerJobId  String? // provider's own id
  operation      String // 'text_to_video', 'tts', ...
  requestBody    Json // truncated for size
  responseBody   Json?
  state          ProviderJobState
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  durationMs     Int?
  costPence      Int              @default(0)
  errorClass     String?
  errorMessage   String?
  retryCount     Int              @default(0)

  @@index([organisationId, provider, startedAt])
  @@index([provider, state])
  @@index([startedAt]) // 13.16 admin provider health (last hour, all providers)
  @@map("provider_jobs")
  @@schema("studio")
}

enum ProviderJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED

  @@schema("studio")
}

// DERIVED — spec 7.2 "Rolled-up cost per (org, provider, day)"; written on every provider
// call (spec 6.7 "Cost meter wired to studio.provider_usage"), read by cost caps (12.5).
model ProviderUsage {
  id             String   @id @default(cuid())
  organisationId String
  provider       String
  day            DateTime @db.Date
  jobCount       Int      @default(0)
  succeededCount Int      @default(0)
  failedCount    Int      @default(0)
  costPence      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, provider, day])
  @@index([provider, day])
  @@index([day]) // Phase 12: global daily cap (spec 12.5) sums one day across all orgs
  @@index([organisationId, day]) // monthly org cap: one org's month-to-date sum
  @@map("provider_usage")
  @@schema("studio")
}

// 7.11 + A7.2 (businessProfileId)
model BrandKit {
  id                String   @id @default(cuid())
  organisationId    String
  businessId        String // ref PostMind Core
  businessProfileId String? // A7.2 — ref BusinessProfile
  name              String
  isDefault         Boolean  @default(false)
  logoAssetId       String?
  watermarkAssetId  String?
  colourPalette     Json // hex colour array
  fontPrimary       String?
  fontSecondary     String?
  toneKeywords      String[]
  audienceProfile   String?
  ctaTemplates      Json // [{ label, template }]
  introCardAssetId  String?
  outroCardAssetId  String?
  voiceProfileId    String?
  restrictedTopics  String[] // never mention
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organisationId, businessId])
  @@map("brand_kits")
  @@schema("studio")
}

// 7.11
model VoiceProfile {
  id                   String    @id @default(cuid())
  organisationId       String
  businessId           String?
  name                 String
  provider             String // 'elevenlabs'
  providerVoiceId      String
  cloneSourceAssetId   String?
  languagesSupported   String[]
  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  // Phase 13.13 (spec 10.2 / 13.4): cloning needs recorded consent. READY | REQUIRES_VERIFICATION
  // (ElevenLabs asked for voice verification) | DELETED (revoked at the provider; the row stays
  // as the consent audit record).
  state                String    @default("READY")
  speakerName          String?
  consentStatement     String?
  consentGivenByUserId String?
  consentGivenAt       DateTime?
  consentS3Bucket      String?
  consentS3Key         String?
  sampleCount          Int       @default(0)
  sampleSeconds        Float?
  deletedAt            DateTime?
  deletedByUserId      String?
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([organisationId, businessId])
  @@map("voice_profiles")
  @@schema("studio")
}

// DERIVED — spec 14.5 onboarding first-run (Phase 13.14): one row per (organisation, user).
// step = where the /welcome wizard resumes; completed = the steps done so far.
model OnboardingState {
  id                  String    @id @default(cuid())
  organisationId      String
  userId              String
  step                String    @default("connect") // connect | brand_kit | first_video | celebrate | done
  completed           String[]
  firstVideoProjectId String?
  dismissedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([organisationId, userId])
  @@map("onboarding_states")
  @@schema("studio")
}

// DERIVED — spec 7.2 "Feedback-informed generation preferences, 1–5 per business" and 10.3/10.4.
// One row per signal category (shot pace, treatment mix, provider preference, script structure,
// posting time — the five 10.3 lists), which gives the "1–5 per business" row count.
// `reason` backs the 10.4 transparency requirement: users can inspect and delete each signal.
model StyleMemory {
  id             String          @id @default(cuid())
  organisationId String
  businessId     String
  signalType     StyleSignalType
  value          Json // e.g. { preferredShotCount: 3, hookWithinSec: 1.2 }
  weight         Float           @default(0)
  evidenceCount  Int             @default(0)
  reason         String // human-readable explanation shown at /brand-memory
  lastEvidenceAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@unique([organisationId, businessId, signalType])
  @@map("style_memories")
  @@schema("studio")
}

enum StyleSignalType {
  SHOT_PACE
  TREATMENT_MIX
  PROVIDER_PREFERENCE
  SCRIPT_STRUCTURE
  POSTING_TIME

  @@schema("studio")
}

// 7.12
model Template {
  id              String   @id @default(cuid())
  organisationId  String? // null = built-in
  name            String
  category        String
  targetFormats   Json
  scriptTemplate  String // Handlebars-style with {{vars}}
  shotBlueprint   Json
  brandKitHints   Json?
  // DERIVED (Phase 12 automation): spec 3 "auto-publish (on approval per template)" names the
  // behaviour but no field. { publishPolicy, reviewPolicy?, targets: [{ platform, connectionId? |
  // platformAccountId?, caption?, hashtags?, scheduleOffsetMinutes? }] } — applied to projects
  // created from the template (src/lib/studio/automation/auto-publish.ts validates it).
  publishDefaults Json?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([organisationId, category])
  @@map("templates")
  @@schema("studio")
}

// 7.12
model ScheduledPublication {
  id            String        @id @default(cuid())
  publicationId String        @unique // pre-created publication row
  scheduledFor  DateTime
  state         ScheduleState
  jobId         String? // bullmq job id

  @@index([scheduledFor, state])
  @@map("scheduled_publications")
  @@schema("studio")
}

enum ScheduleState {
  PENDING
  FIRED
  CANCELLED

  @@schema("studio")
}

// 7.12
model PlatformConnection {
  id                    String    @id @default(cuid())
  organisationId        String
  businessId            String? // NULL: org-wide (Meta channels registered by PostMind Core)
  platform              String // 'tiktok', 'youtube', 'x', 'linkedin', 'instagram', 'facebook'
  platformAccountId     String
  platformAccountName   String
  encryptedAccessToken  String // envelope-encrypted
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scopes                String[]
  state                 String // 'active' | 'needs_reconnect' | 'revoked'
  connectedByUserId     String
  connectedAt           DateTime  @default(now())

  @@unique([organisationId, platform, platformAccountId])
  @@map("platform_connections")
  @@schema("studio")
}

// 7.13
model ApprovalWorkflow {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  steps          Json // ordered [{ role, minApprovers }]
  appliesTo      Json // {platforms, businessIds, tags}
  createdAt      DateTime @default(now())

  @@map("approval_workflows")
  @@schema("studio")
}

// 7.13
model ApprovalTask {
  id               String            @id @default(cuid())
  projectId        String
  project          VideoProject      @relation(fields: [projectId], references: [id])
  workflowId       String?
  stepIndex        Int
  requiredRole     String
  state            ApprovalTaskState
  resolvedByUserId String?
  note             String?
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?

  @@index([projectId, stepIndex])
  @@map("approval_tasks")
  @@schema("studio")
}

enum ApprovalTaskState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("studio")
}

// Kill switch + feature flags. Model copied from the Engagement handover 6.4.1.
// Keys are listed in src/lib/studio/system-flags.ts.
model SystemFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_flags")
  @@schema("studio")
}

// =============================================================================
// v1.1 — Addendum Section A7
// =============================================================================

// A7.3 — Feature A
model VideoLibraryItem {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  categoryId     String
  category       VideoLibraryCategory   @relation(fields: [categoryId], references: [id])
  tags           String[]
  sourceUrl      String?
  sourcePlatform String? // 'tiktok','instagram','user_upload'
  s3Bucket       String
  s3Key          String
  thumbnailS3Key String
  durationSec    Float
  aspectRatio    String
  ingestedAt     DateTime               @default(now())
  analysis       VideoLibraryAnalysis?
  embedding      VideoLibraryEmbedding?
  license        VideoLibraryLicense?
  retiredAt      DateTime? // hidden from search

  @@index([categoryId, retiredAt])
  @@index([tags], type: Gin)
  @@map("video_library")
  @@schema("studio")
}

// DERIVED — A3.2 "Hierarchical category tree … ~200 rows across 3-4 levels", A3.4 seed taxonomy.
model VideoLibraryCategory {
  id        String                 @id @default(cuid())
  slug      String                 @unique // e.g. 'business/e-commerce/fashion'
  name      String
  parentId  String?
  parent    VideoLibraryCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  VideoLibraryCategory[] @relation("CategoryTree")
  depth     Int // 0 = top level
  sortOrder Int                    @default(0)
  items     VideoLibraryItem[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([parentId, sortOrder])
  @@map("video_library_categories")
  @@schema("studio")
}

// DERIVED — A3.2 "Free-form tags … ~5,000 unique tags". Items keep their tags in
// VideoLibraryItem.tags (as A7.3 specifies); this is the tag dictionary used for
// autocomplete and admin curation.
model VideoLibraryTag {
  id         String   @id @default(cuid())
  name       String   @unique
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("video_library_tags")
  @@schema("studio")
}

// A7.4
model VideoLibraryAnalysis {
  id               String           @id @default(cuid())
  libraryItemId    String           @unique
  libraryItem      VideoLibraryItem @relation(fields: [libraryItemId], references: [id])
  shotCount        Int
  shots            Json // [{startSec, endSec, type, overlayStyle, ...}]
  transcript       Json // AssemblyAI output with timestamps
  overlayTimeline  Json // [{startSec, endSec, text, boxRect, style}]
  musicEnvelope    Json // {bpm, key, energy, mood, genre}
  hookPattern      String
  structurePattern String
  ctaPattern       String?
  paceTag          String
  moodTag          String
  analysisVersion  Int              @default(1)

  @@map("video_library_analysis")
  @@schema("studio")
}

// A7.4 — vector column written and searched with raw SQL (Prisma models it as Unsupported).
model VideoLibraryEmbedding {
  id             String                      @id @default(cuid())
  libraryItemId  String                      @unique
  libraryItem    VideoLibraryItem            @relation(fields: [libraryItemId], references: [id])
  embedding      Unsupported("vector(1536)")
  embeddingModel String // 'openai:text-embedding-3-large'
  visualWeight   Float                       @default(0.4)
  audioWeight    Float                       @default(0.3)
  textWeight     Float                       @default(0.3)

  @@map("video_library_embeddings")
  @@schema("studio")
}

// A7.4
model VideoLibraryLicense {
  id             String           @id @default(cuid())
  libraryItemId  String           @unique
  libraryItem    VideoLibraryItem @relation(fields: [libraryItemId], references: [id])
  scenario       LicenseScenario
  licenseSource  String?
  licenseExpires DateTime?
  allowedModes   String[] // ['TEMPLATE','INSPIRE'] or ['INSPIRE']
  notes          String?

  @@map("video_library_licenses")
  @@schema("studio")
}

enum LicenseScenario {
  LICENSED
  OWNED
  SCRAPED
  // Operator decision 2026-09-27: operator-owned corpus content that needs no licence.
  // TEMPLATE + INSPIRE; licenseSource records the decision (who/when) as the audit trail.
  NOT_REQUIRED

  @@schema("studio")
}

// Corpus ingestion tracking (BACKLOG 9.2/9.3 monitoring): one row per source URL (runId = the
// ingest job's source hash). No FK to video_library so item cleanup never blocks on history.
model VideoLibraryIngestRun {
  id            String             @id @default(cuid())
  runId         String             @unique
  sourceUrl     String
  sourceRef     String?
  language      String?
  state         LibraryIngestState @default(QUEUED)
  /**
   * Phase 13.15: the submitted ingest item, so failures can be resubmitted from the admin UI.
   */
  item          Json?
  attempts      Int                @default(0)
  libraryItemId String?
  errorReason   String?
  queuedAt      DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime           @updatedAt

  @@index([state, updatedAt])
  @@index([updatedAt])
  @@map("video_library_ingest_runs")
  @@schema("studio")
}

enum LibraryIngestState {
  QUEUED
  RUNNING
  SUCCEEDED
  DUPLICATE
  FAILED

  @@schema("studio")
}

// A7.5 — Feature B
model TextOverlay {
  id                  String          @id @default(cuid())
  shotId              String?
  shot                VideoShot?      @relation(fields: [shotId], references: [id]) // A7.2
  renderId            String? // for whole-video overlays
  // Phase 13.4 — per-slide overlays (slideshows). Deleting the slide deletes its overlays.
  slideId             String?
  slide               SlideshowSlide? @relation(fields: [slideId], references: [id], onDelete: Cascade)
  presetId            String?
  sortOrder           Int             @default(0)
  text                String
  lang                String          @default("en-GB")
  startAtSec          Float
  endAtSec            Float
  animationInMs       Int             @default(400)
  animationOutMs      Int             @default(400)
  animationIn         String // fadeIn, slideInLeft, ...
  animationOut        String
  easing              String          @default("easeInOut")
  fontFamily          String
  fontWeight          Int             @default(700)
  fontSizePct         Float // % of frame height
  fontItalic          Boolean         @default(false)
  letterSpacing       Float?
  lineHeight          Float?
  fillColor           String // hex+alpha
  strokeColor         String?
  strokeWidthPx       Float?
  shadowColor         String?
  shadowBlurPx        Float?
  shadowOffsetXPx     Float?
  shadowOffsetYPx     Float?
  backgroundType      String          @default("none") // none|box|rounded_box|gradient|blur
  backgroundColor     String?
  backgroundPaddingPx Float?
  backgroundRadiusPx  Float?
  anchorX             Float // 0.0-1.0
  anchorY             Float
  alignment           String          @default("center")
  rotationDeg         Float           @default(0)
  effect              Json? // wave/glitch/karaoke
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([shotId])
  @@index([renderId])
  @@index([slideId])
  @@map("text_overlays")
  @@schema("studio")
}

// A7.5
model OverlayPreset {
  id                String      @id @default(cuid())
  scope             PresetScope
  organisationId    String?
  businessId        String?
  name              String
  group             String // 'hook','subtitle','cta',...
  parameters        Json // full overlay parameter set
  brandSubstitution Boolean     @default(true)
  isPublic          Boolean     @default(false)
  createdAt         DateTime    @default(now())

  @@index([scope, group])
  @@index([organisationId])
  @@map("overlay_presets")
  @@schema("studio")
}

enum PresetScope {
  BUILT_IN
  ORG
  BUSINESS

  @@schema("studio")
}

// A7.6 — Feature C
model SlideshowSlide {
  id              String        @id @default(cuid())
  projectId       String // ref VideoProject
  sortOrder       Int
  slideType       SlideType
  imageAssetId    String? // ref ImageLibraryItem
  videoAssetId    String? // ref VideoAsset
  backgroundColor String? // for TEXT_CARD
  durationSec     Float         @default(2.5)
  transitionIn    String?
  transitionOut   String?
  kenBurnsSpec    Json? // {startZoom,endZoom,startPan,endPan}
  metadata        Json?
  overlays        TextOverlay[] // Phase 13.4
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId, sortOrder])
  @@map("slideshow_slides")
  @@schema("studio")
}

enum SlideType {
  IMAGE_STILL
  IMAGE_KENBURNS
  VIDEO_CLIP
  TEXT_CARD
  BEFORE_AFTER
  QUOTE
  STATISTIC
  PRODUCT

  @@schema("studio")
}

// A7.6
model SlideshowTemplate {
  id                      String   @id @default(cuid())
  organisationId          String? // null = built-in
  name                    String
  category                String // 'photo_dump','listicle_5','before_after',...
  slidePlan               Json // ordered slide blueprints
  musicMood               String?
  defaultDurationPerSlide Float    @default(2.5)
  overlayDefaults         Json?
  createdAt               DateTime @default(now())

  @@map("slideshow_templates")
  @@schema("studio")
}

// A7.7 — Feature D
model BusinessProfile {
  id                 String   @id @default(cuid())
  organisationId     String
  businessId         String
  industry           String
  subNiche           String
  products           String[]
  services           String[]
  audienceKeywords   String[]
  toneIndicators     String[]
  regions            String[]
  imageThemes        String[]
  imageSearchQueries String[] // seeded queries for stock APIs
  restrictedTopics   String[]
  brandVoiceSummary  String?
  classifierModel    String
  classifierVersion  Int      @default(1)
  lastRefreshedAt    DateTime @default(now())
  editedByUser       Boolean  @default(false)

  // DEVIATION (A7.7 has businessId @unique): Core cannot verify business ids, so uniqueness is
  // per organisation — one tenant can never claim or block another tenant's business id.
  @@unique([organisationId, businessId])
  @@map("business_profiles")
  @@schema("studio")
}

// A7.7
model WebsiteScan {
  id                 String    @id @default(cuid())
  organisationId     String
  businessId         String
  url                String
  state              ScanState
  pagesCrawled       Int       @default(0)
  imagesIngested     Int       @default(0)
  errorReason        String?
  robotsBlocked      Boolean   @default(false)
  usedJsRender       Boolean   @default(false)
  costPence          Int       @default(0)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  // A6.6 skip-if-unchanged (Phase 13.10): the homepage validators seen by this scan, the last
  // time a scheduled conditional request found the site unchanged, and the plan tier the scan
  // was started at (scheduled rescans run at it; Core's tier is only known on a request).
  etag               String?
  lastModified       String?
  checkedUnchangedAt DateTime?
  planTier           String?
  trigger            String    @default("manual") // manual | scheduled
  // BACKLOG 14.4: the owner's "I own or represent this website" confirmation, stored per scan
  // (a scheduled rescan carries the confirmation of the scan it repeats). The browser-render
  // fallback for a blocked homepage is only ever used when this is set.
  ownershipConfirmedAt       DateTime?
  ownershipConfirmedByUserId String?

  @@index([businessId, startedAt])
  @@index([state, completedAt])
  @@map("website_scans")
  @@schema("studio")
}

enum ScanState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("studio")
}

// DERIVED — Addendum A6.7 / A11.2 "Verification (Enterprise): a DNS TXT record … to confirm
// ownership" and "if the user later reports they did not own the site, all scraped content is
// purged within 24 hours" (Phase 13.11). One row per verification attempt; the newest row of a
// business is its current state.
model DomainVerification {
  id                String                  @id @default(cuid())
  organisationId    String
  businessId        String
  domain            String
  /**
   * Random token; the TXT value is `pm-studio-verify=<token>`.
   */
  token             String
  state             DomainVerificationState @default(PENDING)
  requestedByUserId String
  checkAttempts     Int                     @default(0)
  lastCheckedAt     DateTime?
  lastError         String?
  verifiedAt        DateTime?
  expiresAt         DateTime // PENDING rows stop being polled (→ EXPIRED) after this
  disputedAt        DateTime?
  disputedByUserId  String?
  disputeReason     String?
  purgeDueAt        DateTime? // disputedAt + 24 h (A6.7)
  purgedAt          DateTime?
  purgeSummary      Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([organisationId, businessId, createdAt])
  @@index([state, lastCheckedAt])
  @@map("domain_verifications")
  @@schema("studio")
}

enum DomainVerificationState {
  PENDING
  VERIFIED
  EXPIRED
  DISPUTED
  PURGED

  @@schema("studio")
}

// A7.7
// DEVIATION — `embedding` is optional here (spec: required). Images are ingested before
// their embedding is computed, and a required Unsupported column removes Prisma's create()
// for the model entirely. Rows without an embedding are excluded from similarity search.
model ImageLibraryItem {
  id                  String                       @id @default(cuid())
  organisationId      String
  businessId          String
  source              ImageSource
  sourceUrl           String?
  sourceProvider      String? // 'pexels','storyblocks','dalle-3'
  s3Bucket            String
  s3Key               String
  publicUrl           String?
  widthPx             Int
  heightPx            Int
  fileSizeBytes       Int
  tags                String[]
  altText             String?
  fingerprint         String // sha256 of the bytes (exact dedup); hotlinked stock: provider:id
  // Phase 13.12: 64-bit dHash (16 hex chars) of the decoded image; near-duplicates within a
  // business (Hamming distance <= 6) are skipped at ingest. Null for hotlinked stock.
  phash               String?
  generatedFromPrompt String?
  embedding           Unsupported("vector(1536)")?
  licenseNotes        String?
  lastUsedAt          DateTime?
  useCount            Int                          @default(0)
  createdAt           DateTime                     @default(now())

  // DEVIATION (A7.7: businessId + fingerprint): scoped per organisation, see business_profiles.
  @@unique([organisationId, businessId, fingerprint])
  @@index([businessId, source])
  @@index([tags], type: Gin)
  @@map("image_library")
  @@schema("studio")
}

enum ImageSource {
  SCRAPED
  STOCK
  GENERATED
  UPLOAD

  @@schema("studio")
}

// A7.7
model ImageLibraryQuery {
  id          String   @id @default(cuid())
  businessId  String
  query       String
  provider    String
  resultCount Int
  lastRunAt   DateTime @default(now())

  @@unique([businessId, provider, query])
  @@map("image_library_queries")
  @@schema("studio")
}

// =============================================================================
// Phase 12 — cost caps, alerting and notifications
// =============================================================================

// DERIVED — spec 12.5 "alert on 80% / 100% of any cap" (and the 90% project pause). One row per
// alert raised; the unique key makes each (scope, scopeId, period, threshold) fire exactly once.
// period: the UTC day (YYYY-MM-DD) for daily caps; `budget:<costBudgetPence>` for a project, so
// raising a project's budget re-arms its alerts.
model CostAlert {
  id             String         @id @default(cuid())
  scope          CostAlertScope
  scopeId        String // projectId | organisationId | organisationId/provider | 'global'
  organisationId String? // null for the global cap
  period         String
  threshold      Int // percent of the cap: 80 | 90 (project pause) | 100
  capPence       Int
  spentPence     Int
  createdAt      DateTime       @default(now())

  @@unique([scope, scopeId, period, threshold])
  @@index([createdAt])
  @@index([organisationId, createdAt])
  @@map("cost_alerts")
  @@schema("studio")
}

enum CostAlertScope {
  PROJECT
  ORG_DAILY
  ORG_MONTHLY
  ORG_PROVIDER_DAILY
  GLOBAL_DAILY

  @@schema("studio")
}

// DERIVED — spec 14.4 notifications (in-app store; no PostMind Core notification API is
// documented). userId null = every member of the organisation. dedupeKey makes an event notify
// once (e.g. approval_pending:<projectId>:<runId>).
model Notification {
  id             String    @id @default(cuid())
  organisationId String
  userId         String?
  kind           String // cost_alert | cost_paused | publication_failed | generation_complete | approval_pending
  title          String
  body           String
  link           String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  /// BACKLOG 13.33: null = no email requested; pending_setup | sent | failed (notifications/email.ts).
  emailStatus    String?

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, createdAt])
  @@index([organisationId, userId, readAt])
  @@map("notifications")
  @@schema("studio")
}

// =============================================================================
// Phase 13 track A3 — admin, automation and cost (migration 20260929030000_admin_automation)
// =============================================================================

// DERIVED — 13.17 / spec 16.4 content-safety review queue. A script-safety REVIEW verdict or a
// review-level content-safety result pauses the run (the project keeps its pipeline state) and
// opens one row per (project, run, kind); staff ALLOW resumes the run, BLOCK fails it.
model SafetyReview {
  id              String            @id @default(cuid())
  organisationId  String
  projectId       String
  runId           String
  kind            String // 'script' | 'content'
  state           SafetyReviewState @default(PENDING)
  reason          String
  details         Json? // script: { verdict, categories }; content: [{ renderId, platform, detail }]
  renderIds       String[]
  planTier        String
  decidedByUserId String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([projectId, runId, kind])
  @@index([state, createdAt])
  @@index([organisationId, createdAt])
  @@map("safety_reviews")
  @@schema("studio")
}

enum SafetyReviewState {
  PENDING
  ALLOWED
  BLOCKED

  @@schema("studio")
}

// DERIVED — 13.18 per-organisation review policy set by PostMind staff. No row = the platform
// defaults (REQUIRE_APPROVAL for new projects, auto-approve allowed, env trust threshold).
model OrgPolicy {
  organisationId            String        @id
  defaultReviewPolicy       ReviewPolicy?
  autoApproveAllowed        Boolean       @default(true)
  autoApproveTrustThreshold Int?
  updatedByUserId           String
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@map("org_policies")
  @@schema("studio")
}

// DERIVED — 13.19 per-organisation cost cap overrides (pence of provider spend). A null column
// means "no override" (the env / code default for the plan tier applies).
model OrgCostCap {
  organisationId  String   @id
  dailyPence      Int?
  monthlyPence    Int?
  reason          String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("org_cost_caps")
  @@schema("studio")
}

// DERIVED — 13.21 auto-publish outbox: one row per target, written in the approval transaction
// and sent by the dispatcher with retry, so an approval can never be lost between two steps.
model AutoPublishOutbox {
  id             String                 @id @default(cuid())
  organisationId String
  projectId      String
  approvalTaskId String
  targetIndex    Int
  target         Json
  planTier       String
  trigger        String // 'human' | 'auto'
  state          AutoPublishOutboxState @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  lockedAt       DateTime?
  lastError      String?
  publicationId  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([approvalTaskId, targetIndex])
  @@index([state, nextAttemptAt])
  @@index([projectId, createdAt])
  @@map("auto_publish_outbox")
  @@schema("studio")
}

enum AutoPublishOutboxState {
  PENDING
  SENDING
  SENT
  FAILED

  @@schema("studio")
}

// DERIVED — 13.22 organisation purge (spec 8.x internal API, Engagement 14.13): tokens wiped at
// once, Studio data soft-deleted, hard deletion due after graceUntil (30 days).
model OrganisationPurge {
  organisationId        String    @id
  requestedAt           DateTime  @default(now())
  graceUntil            DateTime
  channelsWiped         Int
  projectsDeleted       Int
  publicationsCancelled Int
  state                 String // 'soft_deleted' | 'hard_deleting' | 'hard_deleted' | 'cancelled' (14.1)
  hardDeletedAt         DateTime?
  // BACKLOG 14.1: the row is the tombstone kept after hard deletion — what was deleted (rows per
  // table, objects per bucket/prefix, accumulated across resumed attempts) and when.
  hardDeleteStartedAt   DateTime?
  hardDeleteAttempts    Int       @default(0)
  hardDeleteSummary     Json?
  hardDeleteError       String?

  @@index([graceUntil])
  @@map("organisation_purges")
  @@schema("studio")
}

// DERIVED — 13.24 notification preferences per user and kind. No row = defaults (in-app on,
// email off). Email is stored but not delivered until an email channel exists (Wave B 13.33).
model NotificationPreference {
  organisationId String
  userId         String
  kind           String
  inApp          Boolean  @default(true)
  email          Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@id([organisationId, userId, kind])
  @@map("notification_preferences")
  @@schema("studio")
}

// =============================================================================
// Phase 13 track A1 — create and review (migration 20260929010000_create_review)
// =============================================================================

// DERIVED — 13.5 user uploads (sourceType UPLOAD source videos and slideshow VIDEO_CLIP slides).
// The browser PUTs the file straight to S3 with a presigned URL; /complete checks its size and
// probes it (ffprobe). A source video's video_assets row is created with its project (the
// column needs a project id); a slide clip's asset is created at /complete.
model VideoUpload {
  id              String      @id @default(cuid())
  organisationId  String
  businessId      String?
  createdByUserId String
  kind            UploadKind
  projectId       String? // SLIDE_CLIP: the slideshow; SOURCE_VIDEO: set when a project uses it
  fileName        String
  contentType     String
  declaredBytes   BigInt
  s3Bucket        String
  s3Key           String
  state           UploadState @default(PENDING)
  assetId         String? // ref VideoAsset once one exists
  durationSec     Float?
  widthPx         Int?
  heightPx        Int?
  sizeBytes       BigInt?
  errorReason     String?
  expiresAt       DateTime // presigned PUT expiry
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([organisationId, createdAt])
  @@index([projectId])
  @@map("video_uploads")
  @@schema("studio")
}

enum UploadKind {
  SOURCE_VIDEO
  SLIDE_CLIP

  @@schema("studio")
}

enum UploadState {
  PENDING
  READY
  FAILED

  @@schema("studio")
}

// BACKLOG 14.11 — beta programme (playbook 10.4). One row per organisation in the beta. While
// plusUntil is in the future the organisation's effective plan tier for Studio routing, cost
// caps and auto-approve is at least PLUS (services/beta.ts), whatever Core reports.
model OrganisationBeta {
  organisationId  String    @id
  cohort          String // e.g. 'beta-1'
  plusUntil       DateTime?
  enrolledAt      DateTime  @default(now())
  updatedByUserId String
  updatedAt       DateTime  @updatedAt

  @@index([cohort])
  @@map("organisation_beta")
  @@schema("studio")
}

// BACKLOG 14.11 — in-app feedback (POST /api/studio/feedback), read by staff.
model BetaFeedback {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  kind           String // 'bug' | 'idea' | 'praise' | 'other'
  message        String
  projectId      String?
  screen         String
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("beta_feedback")
  @@schema("studio")
}

// BACKLOG 14.11 — Trust & Safety monthly audit: published publications sampled for a human
// re-check. result 'pending' until staff record 'pass' or 'miss' (a miss = Hive let through
// content that should have been blocked or reviewed; runbook metric "Hive scan miss rate").
model SafetyAuditItem {
  id               String    @id @default(cuid())
  period           String // 'YYYY-MM' (UTC) the sample was drawn for
  organisationId   String
  publicationId    String
  projectId        String
  platform         String
  platformUrl      String?
  publishedAt      DateTime
  result           String    @default("pending") // 'pending' | 'pass' | 'miss'
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([period, publicationId])
  @@index([period, result])
  @@map("safety_audit_items")
  @@schema("studio")
}
