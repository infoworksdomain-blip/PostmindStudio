// DERIVED — 13.5 user uploads (sourceType UPLOAD source videos and slideshow VIDEO_CLIP slides).
// The browser PUTs the file straight to S3 with a presigned URL; /complete checks its size and
// probes it (ffprobe). A source video's video_assets row is created with its project (the
// column needs a project id); a slide clip's asset is created at /complete.
model VideoUpload {
  id                 String      @id @default(cuid())
  organisationId     String
  businessId         String?
  createdByUserId    String
  kind               UploadKind
  projectId          String? // SLIDE_CLIP: the slideshow; SOURCE_VIDEO: set when a project uses it
  fileName           String
  contentType        String
  declaredBytes      BigInt
  s3Bucket           String
  s3Key              String
  state              UploadState @default(PENDING)
  assetId            String? // ref VideoAsset once one exists
  durationSec        Float?
  widthPx            Int?
  heightPx           Int?
  sizeBytes          BigInt?
  errorReason        String?
  expiresAt          DateTime // presigned PUT expiry
  // 15.B1: brand fonts — A11.5 licence confirmation for commercial embedding, and the family
  // name embedded in the font (Shotstack matches fonts by it).
  licenceConfirmedAt DateTime?
  fontFamily         String?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organisationId, createdAt])
  @@index([projectId])
  @@map("video_uploads")
  @@schema("studio")
}

enum UploadKind {
  SOURCE_VIDEO
  SLIDE_CLIP
  BRAND_LOGO
  BRAND_WATERMARK
  BRAND_CARD
  BRAND_FONT

  @@schema("studio")
}

enum UploadState {
  PENDING
  READY
  FAILED

  @@schema("studio")
}

// =============================================================================
// Phase 15 track E — data rights, integrations and sharing
// (migration 20261001050000_data_rights_integrations)
// =============================================================================

// DERIVED — 15.E1 spec 18.4 "Right to access: user can export all their Studio data" and A11.7
// (profile exportable "via API export"). One row per request. activeKey = organisationId while
// QUEUED / RUNNING (unique: one export at a time per organisation), null once finished. The ZIP
// is written to the assets bucket; its link lives 7 days (the retention sweep then deletes it).
model DataExport {
  id                String    @id @default(cuid())
  organisationId    String
  requestedByUserId String
  include           String[]
  state             String    @default("QUEUED") // QUEUED | RUNNING | READY | FAILED | EXPIRED
  activeKey         String?   @unique
  s3Bucket          String?
  s3Key             String?
  bytes             Int?
  summary           Json? // { tables: { name: rows }, assets: n, truncated: [name] }
  errorReason       String?
  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organisationId, createdAt])
  @@index([state, expiresAt])
  @@map("data_exports")
  @@schema("studio")
}

// DERIVED — 15.E2 spec 7.14 / 16.2 business.deleted and A11.7 "on business deletion, profile is
// deleted within 30 days". Core calls the internal business purge; rows are soft-deleted at
// once where the table supports it and everything is hard-deleted after graceUntil.
model BusinessPurge {
  id                    String    @id @default(cuid())
  organisationId        String
  businessId            String
  requestedAt           DateTime  @default(now())
  graceUntil            DateTime
  projectsDeleted       Int
  publicationsCancelled Int
  styleMemoriesDeleted  Int
  state                 String // 'soft_deleted' | 'hard_deleted'
  hardDeletedAt         DateTime?
  hardDeleteSummary     Json? // rows deleted per table + S3 objects removed

  @@unique([organisationId, businessId])
  @@index([state, graceUntil])
  @@map("business_purges")
  @@schema("studio")
}

// DERIVED — 15.E3 spec 8.8 attribute-conversation / 15.4 "Which script hooks convert best to
// inbox leads?". One row per (publication, Engagement conversation); repeats are idempotent.
model PublicationConversation {
  id             String   @id @default(cuid())
  organisationId String
  publicationId  String
  conversationId String // ref Engagement conversation (plain string, spec 7.14)
  kind           String // comment | dm | mention
  isLead         Boolean  @default(false)
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([publicationId, conversationId])
  @@index([organisationId, receivedAt])
  @@map("publication_conversations")
  @@schema("studio")
}

// DERIVED — 15.E4 spec 18.5: requests received at policy@postmind.ai (and platform / regulator
// notices), entered by PostMind staff; counted in the annual transparency report.
model TakedownRequest {
  id               String    @id @default(cuid())
  receivedAt       DateTime
  source           String // policy_mailbox | platform | regulator | court | other
  category         String // copyright | privacy | defamation | safety | impersonation | regulatory | other
  requester        String?
  reference        String?
  organisationId   String?
  publicationId    String?
  summary          String
  state            String    @default("OPEN") // OPEN | ACTIONED | REJECTED
  resolutionNote   String?
  enteredByUserId  String
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([receivedAt])
  @@index([state, receivedAt])
  @@map("takedown_requests")
  @@schema("studio")
}

// DERIVED — 15.E5 spec 4.4 "public smart-preview links for approvals" (view + comment only;
// approving from a link waits on decision P8). Only the SHA-256 of the token is stored.
model ShareLink {
  id              String             @id @default(cuid())
  organisationId  String
  projectId       String
  tokenHash       String             @unique
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  viewCount       Int                @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime           @default(now())
  comments        ShareLinkComment[]

  @@index([organisationId, projectId, createdAt])
  @@map("share_links")
  @@schema("studio")
}

model ShareLinkComment {
  id             String    @id @default(cuid())
  shareLinkId    String
  shareLink      ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  organisationId String
  projectId      String
  authorName     String
  // Operator decision P8 (2026-09-28): the reviewer may type an email so the team can reply.
  // Shown to the organisation only, never on the public page.
  authorEmail    String?
  body           String
  createdAt      DateTime  @default(now())

  @@index([shareLinkId, createdAt])
  @@index([projectId, createdAt])
  @@map("share_link_comments")
  @@schema("studio")
}

// DERIVED — 15.W2 spec 16.1 "Studio reports usage events (video-generated,
// provider-cost-incurred) via postmind-core.internal/api/internal/usage". Outbox: rows are
// derived idempotently (eventKey) and stay pending_setup until Core publishes the usage API.
model UsageEvent {
  id             String    @id @default(cuid())
  organisationId String
  eventType      String // video_generated | provider_cost_incurred
  eventKey       String    @unique // render:<id> | provider_job:<id>
  payload        Json
  occurredAt     DateTime
  // pending_setup | sent | failed | local (Phase 18: standalone billing keeps rows as the local
  // usage record; nothing is sent)
  state          String    @default("pending_setup")
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, occurredAt])
  @@index([organisationId, occurredAt])
  @@map("usage_events")
  @@schema("studio")
}

// DERIVED — 15.W3 spec 16.1 "scheduled publications also write shadow entries into PostMind
// Core's content calendar". One row per publication: the entry Core should hold (upsert while
// SCHEDULED, delete otherwise). pending_setup until Core publishes a calendar API.
model CalendarShadow {
  publicationId  String    @id
  organisationId String
  projectId      String
  platform       String
  desiredOp      String // upsert | delete
  scheduledFor   DateTime?
  title          String?
  state          String    @default("pending_setup") // pending_setup | synced | failed
  coreEntryId    String?
  attempts       Int       @default(0)
  lastError      String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, updatedAt])
  @@index([organisationId])
  @@map("calendar_shadows")
  @@schema("studio")
}

// DERIVED — 15.A5 drip queue (spec 3.1 "drip queue", 9.9): per business, weekly posting slots.
// An approved SCHEDULED project without a start time takes the next free slot; its targets are
// staggered from there (auto_publish_outbox.slotAt / scheduledFor).
model DripQueue {
  id              String   @id @default(cuid())
  organisationId  String
  businessId      String
  /// [{ weekday 0-6 (0 = Sunday), time "HH:MM", timezone IANA }]
  slots           Json
  /// 20.14: the posting schedule the slots were made from (src/lib/studio/posting-schedule.ts):
  /// { mode daily | weekly | custom, timezone, postsPerDay, postsPerWeek, days, timesMode
  /// choose | system | interval, times, intervalBy, intervalStart, intervalMinutes, windowStart,
  /// windowEnd }. Null for queues saved before 20.14 (the editor infers one from the slots).
  schedule        Json?
  /// Platforms drip-posted (subset of the project's targets); empty = every target.
  platforms       String[]
  enabled         Boolean  @default(true)
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organisationId, businessId])
  @@map("drip_queues")
  @@schema("studio")
}

// DERIVED — 20.13 captions and hashtags (operator request 2026-10-01): per business, the business
// hashtag every post carries (null = derived from the business name, hashtags/business-hashtag.ts)
// and the owner's "always include" hashtags, added to every generated, approved and auto-published
// post (hashtags/policy.ts).
model BusinessHashtagSettings {
  id              String   @id @default(cuid())
  organisationId  String
  businessId      String
  /// Without "#"; letters/digits/underscore, ≤ 30 characters. NULL = the derived default.
  primaryHashtag  String?
  /// Without "#", in the owner's order (≤ 10, each ≤ 30 characters).
  alwaysHashtags  String[]
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organisationId, businessId])
  @@map("business_hashtag_settings")
  @@schema("studio")
}

// DERIVED — 20.9 "Plan my month" (operator request 2026-09-30): a month of videos and slideshows
// drafted by Claude, edited by the owner, then generated and auto-scheduled (≤ 4 posts a day)
// with a review window. One plan per request; each item becomes one project when generated.
model ContentPlan {
  id                  String            @id @default(cuid())
  organisationId      String
  businessId          String
  createdByUserId     String
  /// Who pressed "Generate and schedule" (their approval covers the plan's items).
  scheduledByUserId   String?
  status              ContentPlanStatus @default(DRAFTING)
  /// First local day of the plan (YYYY-MM-DD in `timezone`) and its length (1–31 days).
  startDate           String
  days                Int
  timezone            String
  /// [windowStart, windowEnd): the plan's instants (local midnight of startDate → + days).
  windowStart         DateTime
  windowEnd           DateTime
  /// 1–4 posts a day, or the business's drip-queue posting times (useDripSlots).
  postsPerDay         Int
  useDripSlots        Boolean           @default(false)
  /// 0–100: the share of items that are videos (the rest are slideshows).
  videoShare          Int               @default(50)
  platforms           String[]
  /// AutoPublishTarget[] (automation/targets.ts), one connected account per platform.
  targets             Json
  language            String            @default("en-GB")
  brandKitId          String?
  /// Plan tier recorded at "Generate and schedule" (the runner's job payloads use it).
  planTier            String?
  /// Items the window and posting times allow, before the allowance / cost cap.
  requestedCount      Int               @default(0)
  /// Why the draft has fewer items than requestedCount: allowance | cost_cap.
  cappedReason        String?
  /// Why the runner is waiting: kill_switch | cost_cap | daily_limit | allowance.
  holdReason          String?
  draftError          String?
  draftModel          String?
  generationStartedAt DateTime?
  /// Every item was scheduled (or held / failed): the summary email went out once.
  scheduledAt         DateTime?
  summaryEmailedAt    DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  metadata            Json?
  items               ContentPlanItem[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organisationId, businessId, createdAt])
  @@index([status, updatedAt])
  @@map("content_plans")
  @@schema("studio")
}

model ContentPlanItem {
  id               String                @id @default(cuid())
  planId           String
  plan             ContentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  organisationId   String
  position         Int
  /// The post time this item was given (item order = slot order).
  slotAt           DateTime
  kind             ContentPlanItemKind
  /// offer | how_to | behind_the_scenes | testimonial | product_feature | seasonal
  angle            String
  title            String
  brief            String
  /// Slideshow text { hook, points[], cta } (used when kind is SLIDESHOW).
  slides           Json?
  /// A seasonal / UK calendar day the item is for (content-plans/calendar-days.ts id).
  calendarDay      String?
  /// 20.13: the post's caption and hashtags per platform { <platform>: { caption, hashtags[],
  /// title? } } (drafted with the topic, edited by the owner; copied to the project's
  /// metadata.postCopy when the item is generated).
  postCopy         Json?
  status           ContentPlanItemStatus @default(PLANNED)
  statusReason     String?
  projectId        String?
  /// The allowance reservation (plan-quotas.ts QuotaReservation minus ids), set at generate.
  quotaReservation Json?
  startedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([planId, position])
  @@index([organisationId, slotAt])
  @@index([projectId])
  @@map("content_plan_items")
  @@schema("studio")
}

enum ContentPlanStatus {
  DRAFTING
  DRAFT
  GENERATING
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("studio")
}

enum ContentPlanItemKind {
  VIDEO
  SLIDESHOW

  @@schema("studio")
}

enum ContentPlanItemStatus {
  PLANNED
  QUEUED
  GENERATING
  READY
  SCHEDULED
  POSTED
  HELD
  FAILED
  SKIPPED
  REMOVED

  @@schema("studio")
}

// DERIVED — Phase 15 operator decision P1 (2026-09-28; spec 6.6 / 12.6): Enterprise
// organisations may bring their own provider API keys (BYOC). Key material is envelope-encrypted
// (crypto/envelope.ts) and wiped on revoke; one row per (organisation, provider), re-used when a
// revoked key is set again. Gated by STUDIO_BYOC_ENABLED.
model ProviderCredential {
  id                    String    @id @default(cuid())
  organisationId        String
  /// BYOC provider id (providers/byoc-providers.ts), e.g. 'runway', 'elevenlabs', 'storyblocks'.
  providerId            String
  /// Envelope-encrypted API key; NULL once revoked.
  encryptedKey          String?
  /// Envelope-encrypted private half of a two-part key (Storyblocks); NULL otherwise.
  encryptedSecondaryKey String?
  /// Non-secret hint: the last 4 characters of the API key.
  hint                  String?
  state                 String    @default("active") // active | revoked
  lastTestedAt          DateTime?
  /// { healthy: boolean, reason?: string } from the adapter's healthCheck().
  lastTestResult        Json?
  createdByUserId       String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([organisationId, providerId])
  @@index([organisationId, state])
  @@map("provider_credentials")
  @@schema("studio")
}

// BACKLOG 14.11 — beta programme (playbook 10.4). One row per organisation in the beta. While
// plusUntil is in the future the organisation's effective plan tier for Studio routing, cost
// caps and auto-approve is at least PLUS (services/beta.ts), whatever Core reports.
model OrganisationBeta {
  organisationId  String    @id
  cohort          String // e.g. 'beta-1'
  plusUntil       DateTime?
  enrolledAt      DateTime  @default(now())
  updatedByUserId String
  updatedAt       DateTime  @updatedAt

  @@index([cohort])
  @@map("organisation_beta")
  @@schema("studio")
}

// BACKLOG 14.11 — in-app feedback (POST /api/studio/feedback), read by staff.
model BetaFeedback {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  kind           String // 'bug' | 'idea' | 'praise' | 'other'
  message        String
  projectId      String?
  screen         String
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("beta_feedback")
  @@schema("studio")
}

// BACKLOG 14.11 — Trust & Safety monthly audit: published publications sampled for a human
// re-check. result 'pending' until staff record 'pass' or 'miss' (a miss = Hive let through
// content that should have been blocked or reviewed; runbook metric "Hive scan miss rate").
model SafetyAuditItem {
  id               String    @id @default(cuid())
  period           String // 'YYYY-MM' (UTC) the sample was drawn for
  organisationId   String
  publicationId    String
  projectId        String
  platform         String
  platformUrl      String?
  publishedAt      DateTime
  result           String    @default("pending") // 'pending' | 'pass' | 'miss'
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([period, publicationId])
  @@index([period, result])
  @@map("safety_audit_items")
  @@schema("studio")
}

// =============================================================================
// Phase 18 — standalone SaaS (plans/phase-18.md §4). Expand-only: new tables plus nullable
// columns. The ~45 existing tables keep organisationId / userId as plain strings with no FK, so
// core mode (Core ids) and standalone mode (Better Auth ids, <= 128 chars) share one schema.
// =============================================================================

// ---- Better Auth core + plugins (better-auth@1.7.6). Model names match Better Auth's default
// model names (user, session, account, verification, organization, member, invitation, twoFactor)
// so the Prisma adapter needs no modelName mapping; @@map gives the plan's table names. Field
// names and types were checked against getSchema() of the pinned version (2026-09-29).

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  // twoFactor plugin
  twoFactorEnabled Boolean?  @default(false)
  // admin plugin: 'user' | 'staff' | 'superadmin' (§2.5)
  role             String?   @default("user")
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  // Studio additional fields
  locale           String? // UI / email locale (one of the 11 LOCALES); null = en-GB
  deletedAt        DateTime? // §5.11 soft delete; rows removed at grace end

  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  members     Member[]
  invitations Invitation[]

  @@map("users")
  @@schema("studio")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  // organization plugin
  activeOrganizationId String?
  // admin plugin (impersonation, off by default)
  impersonatedBy       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("studio")
}

/// Better Auth `account`: one row per sign-in method. The argon2id password hash lives in
/// `password` on the row with providerId 'credential'.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
  @@schema("studio")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
  @@schema("studio")
}

/// twoFactor plugin. `secret` is AES-encrypted by Better Auth with BETTER_AUTH_SECRET
/// (symmetricEncrypt); backup codes are stored encrypted (storeBackupCodes: 'encrypted').
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
  @@schema("studio")
}

/// organization plugin. Studio's organisation (the tenant) in standalone mode.
model Organization {
  id            String    @id
  name          String
  slug          String    @unique
  logo          String?
  createdAt     DateTime  @default(now())
  metadata      String?
  // Studio additional fields
  country       String? // ISO 3166-1 alpha-2, for tax
  defaultLocale String?
  deletedAt     DateTime?

  members     Member[]
  invitations Invitation[]

  @@map("organisations")
  @@schema("studio")
}

/// organization plugin. role: owner | admin | publisher | creator | viewer (§2.4).
model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
  @@schema("studio")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
  @@schema("studio")
}

// ---- Studio tables

/// §2.11: businesses owned by an organisation (standalone mode). Unique (organisationId,
/// lower(name)) among non-deleted rows is a partial expression index created in the migration
/// (businesses_org_lower_name_live_key); Prisma cannot express it.
model Business {
  id              String    @id @default(cuid())
  organisationId  String
  name            String
  domain          String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([organisationId, deletedAt])
  @@map("businesses")
  @@schema("studio")
}

/// §2.6 local audit log. Append-only: a trigger rejects UPDATE / DELETE / TRUNCATE unless the
/// transaction ran SET LOCAL studio.audit_retention = 'on' (only the retention job does).
/// metadata holds ids and codes, never PII.
model AuditLog {
  id                 String   @id @default(cuid())
  occurredAt         DateTime @default(now())
  actorUserId        String?
  actorType          String // user | staff | system | stripe | meta
  impersonatorUserId String?
  organisationId     String?
  action             String
  resourceType       String
  resourceId         String
  metadata           Json?
  ip                 String?
  userAgent          String?
  correlationId      String?

  @@index([organisationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
  @@schema("studio")
}

/// §2.7: one Stripe customer per organisation.
model BillingCustomer {
  organisationId   String    @id
  stripeCustomerId String    @unique
  /// Random nonce mixed into outbound Stripe Idempotency-Key values (orgId, intent, nonce).
  idempotencyNonce String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@map("billing_customers")
  @@schema("studio")
}

/// §2.7: current state of a Stripe subscription (re-fetched from the API on every event).
model Subscription {
  id                 String    @id // Stripe subscription id (sub_...)
  organisationId     String
  stripeCustomerId   String
  status             String // Stripe status: trialing | active | past_due | unpaid | canceled | ...
  lookupKey          String? // studio_<tier>_<interval>
  interval           String? // month | year
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEnd           DateTime?
  stripeUpdatedAt    DateTime? // when we last re-fetched it from Stripe
  // Track C (migration 20261004030000): what the subscription is billed, for the admin MRR view
  // and ENTERPRISE mapping (product metadata studio_tier; ENTERPRISE prices have no lookup key).
  productTier        String?
  unitAmountPence    Int?
  currency           String?
  quantity           Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organisationId])
  @@index([status])
  @@map("subscriptions")
  @@schema("studio")
}

/// §P.3: the resolved plan for an organisation. The single place Studio reads tier / access.
model OrgEntitlement {
  organisationId  String    @id
  tier            String // BASIC | STANDARD | PLUS | ENTERPRISE
  access          String // full | read_only | none
  source          String // stripe | trial | admin | core | none
  graceUntil      DateTime?
  /// Per-org differences (Enterprise quotas, seats, businesses, storage, trial caps).
  overrides       Json?
  /// Set when the organisation first starts a trial (one trial per organisation).
  trialStartedAt  DateTime?
  /// Set once the organisation has paid at least one invoice (canceled: read_only, not none).
  everPaidAt      DateTime?
  reason          String?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?

  @@map("org_entitlements")
  @@schema("studio")
}

/// §P.3 top-up credits: one row per purchased pack, consumed first-in first-out.
model UsageCredit {
  id                      String    @id @default(cuid())
  organisationId          String
  kind                    String // short | long
  packLookupKey           String // studio_topup_short10_basic ...
  quantity                Int
  remaining               Int
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  purchasedAt             DateTime  @default(now())
  expiresAt               DateTime
  refundedAt              DateTime?
  createdAt               DateTime  @default(now())

  @@index([organisationId, kind, expiresAt])
  @@map("usage_credits")
  @@schema("studio")
}

/// One consumed credit; unique per project and month so a retried generate never spends twice.
model UsageCreditUse {
  id             String   @id @default(cuid())
  creditId       String
  organisationId String
  projectId      String
  month          String // 'YYYY-MM' (UTC)
  kind           String // short | long
  createdAt      DateTime @default(now())

  @@unique([projectId, month])
  @@index([organisationId, month])
  @@index([creditId])
  @@map("usage_credit_uses")
  @@schema("studio")
}

/// §2.7 webhook dedupe: one row per Stripe event id. processedAt NULL = the sweeper retries it.
model StripeEvent {
  id          String    @id // evt_...
  type        String
  objectId    String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@map("stripe_events")
  @@schema("studio")
}

/// §2.7 trial abuse control: card fingerprints that already had a trial.
model TrialFingerprint {
  fingerprint    String   @id
  organisationId String
  createdAt      DateTime @default(now())

  @@map("trial_fingerprints")
  @@schema("studio")
}

/// §2.8 transactional email outbox. idempotencyKey = notificationId or auth:<verificationId>.
model EmailOutbox {
  id                String    @id @default(cuid())
  idempotencyKey    String    @unique
  organisationId    String?
  userId            String?
  toAddress         String
  template          String
  locale            String
  params            Json
  /// pending | sending | sent | delivered | delayed | bounced | complained | suppressed | failed
  state             String    @default("pending")
  providerMessageId String?   @unique
  attempts          Int       @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([userId])
  @@map("email_outbox")
  @@schema("studio")
}

/// §2.8 hard bounces and complaints, keyed by SHA-256 of the lowercased address so the
/// suppression outlives account deletion.
model EmailSuppression {
  addressHash String   @id
  reason      String // bounce | complaint | manual
  createdAt   DateTime @default(now())

  @@map("email_suppressions")
  @@schema("studio")
}
