// A7.7
model WebsiteScan {
  id                         String    @id @default(cuid())
  organisationId             String
  businessId                 String
  url                        String
  state                      ScanState
  pagesCrawled               Int       @default(0)
  imagesIngested             Int       @default(0)
  errorReason                String?
  robotsBlocked              Boolean   @default(false)
  usedJsRender               Boolean   @default(false)
  costPence                  Int       @default(0)
  startedAt                  DateTime  @default(now())
  completedAt                DateTime?
  // A6.6 skip-if-unchanged (Phase 13.10): the homepage validators seen by this scan, the last
  // time a scheduled conditional request found the site unchanged, and the plan tier the scan
  // was started at (scheduled rescans run at it; Core's tier is only known on a request).
  etag                       String?
  lastModified               String?
  checkedUnchangedAt         DateTime?
  planTier                   String?
  trigger                    String    @default("manual") // manual | scheduled
  // 15.D8 / A11.2: the ownership checkbox text the user ticked (null: historic or scheduled).
  // 17.8: since Phase 17 it is the approved catalogue text for ownershipStatementLocale +
  // ownershipStatementKey (messages/<locale>.json), checked on the server; both are null on
  // older rows, which keep the free text the client sent.
  ownershipStatement         String?
  ownershipStatementLocale   String?
  ownershipStatementKey      String?
  // BACKLOG 14.4: the owner's "I own or represent this website" confirmation, stored per scan
  // (a scheduled rescan carries the confirmation of the scan it repeats). The browser-render
  // fallback for a blocked homepage is only ever used when this is set.
  ownershipConfirmedAt       DateTime?
  ownershipConfirmedByUserId String?

  @@index([businessId, startedAt])
  @@index([state, completedAt])
  @@map("website_scans")
  @@schema("studio")
}

enum ScanState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("studio")
}

// DERIVED — Addendum A6.7 / A11.2 "Verification (Enterprise): a DNS TXT record … to confirm
// ownership" and "if the user later reports they did not own the site, all scraped content is
// purged within 24 hours" (Phase 13.11). One row per verification attempt; the newest row of a
// business is its current state.
model DomainVerification {
  id                String                  @id @default(cuid())
  organisationId    String
  businessId        String
  domain            String
  /**
   * Random token; the TXT value is `pm-studio-verify=<token>`.
   */
  token             String
  state             DomainVerificationState @default(PENDING)
  requestedByUserId String
  checkAttempts     Int                     @default(0)
  lastCheckedAt     DateTime?
  lastError         String?
  verifiedAt        DateTime?
  expiresAt         DateTime // PENDING rows stop being polled (→ EXPIRED) after this
  disputedAt        DateTime?
  disputedByUserId  String?
  disputeReason     String?
  purgeDueAt        DateTime? // disputedAt + 24 h (A6.7)
  purgedAt          DateTime?
  purgeSummary      Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([organisationId, businessId, createdAt])
  @@index([state, lastCheckedAt])
  @@map("domain_verifications")
  @@schema("studio")
}

enum DomainVerificationState {
  PENDING
  VERIFIED
  EXPIRED
  DISPUTED
  PURGED

  @@schema("studio")
}

// A7.7
// DEVIATION — `embedding` is optional here (spec: required). Images are ingested before
// their embedding is computed, and a required Unsupported column removes Prisma's create()
// for the model entirely. Rows without an embedding are excluded from similarity search.
model ImageLibraryItem {
  id                  String                       @id @default(cuid())
  organisationId      String
  businessId          String
  source              ImageSource
  sourceUrl           String?
  sourceProvider      String? // 'pexels','storyblocks','dalle-3'
  s3Bucket            String
  s3Key               String
  publicUrl           String?
  widthPx             Int
  heightPx            Int
  fileSizeBytes       Int
  tags                String[]
  altText             String?
  fingerprint         String // sha256 of the bytes (exact dedup); hotlinked stock: provider:id
  // Phase 13.12: 64-bit dHash (16 hex chars) of the decoded image; near-duplicates within a
  // business (Hamming distance <= 6) are skipped at ingest. Null for hotlinked stock.
  phash               String?
  generatedFromPrompt String?
  embedding           Unsupported("vector(1536)")?
  licenseNotes        String?
  lastUsedAt          DateTime?
  useCount            Int                          @default(0)
  createdAt           DateTime                     @default(now())

  // DEVIATION (A7.7: businessId + fingerprint): scoped per organisation, see business_profiles.
  @@unique([organisationId, businessId, fingerprint])
  @@index([businessId, source])
  @@index([tags], type: Gin)
  @@map("image_library")
  @@schema("studio")
}

enum ImageSource {
  SCRAPED
  STOCK
  GENERATED
  UPLOAD

  @@schema("studio")
}

// A7.7
model ImageLibraryQuery {
  id          String   @id @default(cuid())
  businessId  String
  query       String
  provider    String
  resultCount Int
  lastRunAt   DateTime @default(now())

  @@unique([businessId, provider, query])
  @@map("image_library_queries")
  @@schema("studio")
}

// =============================================================================
// Phase 12 — cost caps, alerting and notifications
// =============================================================================

// DERIVED — spec 12.5 "alert on 80% / 100% of any cap" (and the 90% project pause). One row per
// alert raised; the unique key makes each (scope, scopeId, period, threshold) fire exactly once.
// period: the UTC day (YYYY-MM-DD) for daily caps; `budget:<costBudgetPence>` for a project, so
// raising a project's budget re-arms its alerts.
model CostAlert {
  id             String         @id @default(cuid())
  scope          CostAlertScope
  scopeId        String // projectId | organisationId | organisationId/provider | 'global'
  organisationId String? // null for the global cap
  period         String
  threshold      Int // percent of the cap: 80 | 90 (project pause) | 100
  capPence       Int
  spentPence     Int
  createdAt      DateTime       @default(now())

  @@unique([scope, scopeId, period, threshold])
  @@index([createdAt])
  @@index([organisationId, createdAt])
  @@map("cost_alerts")
  @@schema("studio")
}

enum CostAlertScope {
  PROJECT
  ORG_DAILY
  ORG_MONTHLY
  ORG_PROVIDER_DAILY
  GLOBAL_DAILY

  @@schema("studio")
}

// DERIVED — spec 14.4 notifications (in-app store; no PostMind Core notification API is
// documented). userId null = every member of the organisation. dedupeKey makes an event notify
// once (e.g. approval_pending:<projectId>:<runId>).
model Notification {
  id             String    @id @default(cuid())
  organisationId String
  userId         String?
  kind           String // cost_alert | cost_paused | publication_failed | generation_complete | approval_pending
  title          String
  body           String
  link           String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  /// BACKLOG 13.33: null = no email requested; pending_setup | sent | failed (notifications/email.ts).
  emailStatus    String?
  /// BACKLOG 16.5: catalogue key (notifications.<key>) + ICU params; title/body stay the English fallback.
  messageKey     String?
  messageParams  Json?

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, createdAt])
  @@index([organisationId, userId, readAt])
  @@map("notifications")
  @@schema("studio")
}

