// Phase 13 track A3 — admin, automation and cost (migration 20260929030000_admin_automation)
// =============================================================================

// DERIVED — 13.17 / spec 16.4 content-safety review queue. A script-safety REVIEW verdict or a
// review-level content-safety result pauses the run (the project keeps its pipeline state) and
// opens one row per (project, run, kind); staff ALLOW resumes the run, BLOCK fails it.
model SafetyReview {
  id              String            @id @default(cuid())
  organisationId  String
  projectId       String
  runId           String
  kind            String // 'script' | 'content'
  state           SafetyReviewState @default(PENDING)
  reason          String
  details         Json? // script: { verdict, categories }; content: [{ renderId, platform, detail }]
  renderIds       String[]
  planTier        String
  decidedByUserId String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([projectId, runId, kind])
  @@index([state, createdAt])
  @@index([organisationId, createdAt])
  @@map("safety_reviews")
  @@schema("studio")
}

enum SafetyReviewState {
  PENDING
  ALLOWED
  BLOCKED

  @@schema("studio")
}

// DERIVED — 13.18 per-organisation review policy set by PostMind staff. No row = the platform
// defaults (REQUIRE_APPROVAL for new projects, auto-approve allowed, env trust threshold).
model OrgPolicy {
  organisationId            String        @id
  defaultReviewPolicy       ReviewPolicy?
  autoApproveAllowed        Boolean       @default(true)
  autoApproveTrustThreshold Int?
  // Operator decision P2 (2026-09-28): white-labelled outputs carry no Studio marks. ENTERPRISE
  // is always white-label; staff may flag other organisations here.
  whiteLabel                Boolean       @default(false)
  updatedByUserId           String
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@map("org_policies")
  @@schema("studio")
}

// DERIVED — 13.19 per-organisation cost cap overrides (pence of provider spend). A null column
// means "no override" (the env / code default for the plan tier applies).
model OrgCostCap {
  organisationId  String   @id
  dailyPence      Int?
  monthlyPence    Int?
  reason          String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("org_cost_caps")
  @@schema("studio")
}

// DERIVED — 13.21 auto-publish outbox: one row per target, written in the approval transaction
// and sent by the dispatcher with retry, so an approval can never be lost between two steps.
model AutoPublishOutbox {
  id             String                 @id @default(cuid())
  organisationId String
  projectId      String
  approvalTaskId String
  targetIndex    Int
  target         Json
  planTier       String
  trigger        String // 'human' | 'auto'
  state          AutoPublishOutboxState @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  lockedAt       DateTime?
  lastError      String?
  publicationId  String?
  /// 15.A5: absolute publish time (SCHEDULED projects and drip slots, staggered per target).
  scheduledFor   DateTime?
  /// 15.A5: the drip slot this approval took (target 0's time); unique per business in use.
  slotAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([approvalTaskId, targetIndex])
  @@index([slotAt])
  @@index([state, nextAttemptAt])
  @@index([projectId, createdAt])
  @@map("auto_publish_outbox")
  @@schema("studio")
}

enum AutoPublishOutboxState {
  PENDING
  SENDING
  SENT
  FAILED

  @@schema("studio")
}

// DERIVED — 13.22 organisation purge (spec 8.x internal API, Engagement 14.13): tokens wiped at
// once, Studio data soft-deleted, hard deletion due after graceUntil (30 days).
model OrganisationPurge {
  organisationId        String    @id
  requestedAt           DateTime  @default(now())
  graceUntil            DateTime
  channelsWiped         Int
  projectsDeleted       Int
  publicationsCancelled Int
  state                 String // 'soft_deleted' | 'hard_deleting' | 'hard_deleted' | 'cancelled' (14.1)
  hardDeletedAt         DateTime?
  // BACKLOG 14.1: the row is the tombstone kept after hard deletion — what was deleted (rows per
  // table, objects per bucket/prefix, accumulated across resumed attempts) and when.
  hardDeleteStartedAt   DateTime?
  hardDeleteAttempts    Int       @default(0)
  hardDeleteSummary     Json?
  hardDeleteError       String?

  @@index([graceUntil])
  @@map("organisation_purges")
  @@schema("studio")
}

// DERIVED — 13.24 notification preferences per user and kind. No row = defaults (in-app on,
