# Loaded by `next dev` only (never by production builds). Local defaults for working on the UI
# without PostMind Core — no secrets. Real credentials go in .env.local (git-ignored), which
# overrides these.
#
# Start the local database first:  npm run db:local   (PGlite on :55432; then npx prisma migrate deploy)

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?schema=studio&connection_limit=1&sslmode=disable&pgbouncer=true"
REDIS_URL="redis://127.0.0.1:6379/3"
APP_URL="http://localhost:3010"

# Run every API request as this tenant ("<organisationId>:<userId>"); honoured under next dev only.
STUDIO_DEV_TENANT="dev-org:dev-user"

AWS_REGION="eu-west-2"
S3_BUCKET_ASSETS="studio-assets-dev"
S3_BUCKET_RENDERS="studio-renders-dev"
S3_BUCKET_LIBRARY="studio-library-assets-dev"

# Provider pricing conversion (not a secret; matches .env.example).
STUDIO_USD_TO_GBP_RATE="0.75"
